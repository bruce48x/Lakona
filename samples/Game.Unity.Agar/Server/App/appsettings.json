{
  "ConnectionStrings": {
    "AgarPostgres": "Host=postgres;Port=5432;Database=lakona-game;Username=lakona-game;Password=lakona-game_dev_password",
    "AgarRedis": "redis:6379,password=lakona-game_redis_dev_password"
  },
  "Lakona": {
    "Node": {
      "Id": "gateway-1"
    },
    "Feature": [],
    "Actors": {
      "CallTimeoutSeconds": 5,
      "SlowMessageThresholdSeconds": 1
    },
    "Sessions": {
      "Cleanup": {
        "IntervalSeconds": 30,
        "DisconnectedRetentionSeconds": 120
      }
    },
    "Endpoints": [
      {
        "Transport": "websocket",
        "Serializer": "memorypack",
        "Host": "127.0.0.1",
        "Port": 20000,
        "Path": "/ws",
        "RpcServices": [ "login", "player" ]
      },
      {
        "Transport": "kcp",
        "Serializer": "memorypack",
        "Host": "127.0.0.1",
        "Port": 20001,
        "RpcServices": [ "battle" ]
      }
    ]
  }
}
