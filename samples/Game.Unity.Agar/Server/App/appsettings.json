{
  "ConnectionStrings": {
    "AgarGamePostgres": "Host=127.0.0.1;Port=5432;Database=lakona-game;Username=lakona-game;Password=lakona-game_dev_password",
    "AgarGameRedis": "127.0.0.1:6379,password=lakona-game_redis_dev_password"
  },
  "Lakona": {
    "Node": {
      "Id": "gateway-1"
    },
    "ActorHosts": [ "user", "matchmaking", "leaderboard", "room" ],
    "Cluster": {
      "Endpoint": "tcp://127.0.0.1:21001",
      "BootstrapNewCluster": true,
      "Seeds": []
    },
    "Actors": {
      "CallTimeoutSeconds": 5,
      "SlowMessageThresholdSeconds": 1
    },
    "Sessions": {
      "ResumeWindowSeconds": 60,
      "Cleanup": {
        "IntervalSeconds": 30
      }
    },
    "Hotfix": {
      "DebugWatcher": "On"
    },
    "Http": {
      "Listeners": [
        {
          "Id": "operations",
          "Host": "127.0.0.1",
          "Port": 21000,
          "Exposure": "Internal",
          "Services": [ "agar-operations" ],
          "MaximumBodyBytes": 16384,
          "RequestTimeoutSeconds": 10
        }
      ]
    },
    "Management": {
      "Http": {
        "Host": "127.0.0.1",
        "Port": 20080
      }
    },
    "Health": {
      "Enabled": true,
      "RequireLoopback": true
    },
    "Observability": {
      "LocalAdmin": {
        "Enabled": true,
        "RequireLoopback": true
      },
      "Logging": {
        "Categories": {
          "Server.App": "Trace",
          "Server.Hotfix": "Trace",
          "Lakona.Game.Hotfix": "Information",
          "Lakona.Rpc.Server.Request": "Debug"
        }
      }
    },
    "Endpoints": [
      {
        "Transport": "websocket",
        "Serializer": "memorypack",
        "Host": "127.0.0.1",
        "Port": 20000,
        "Path": "/ws",
        "ReliablePush": true,
        "RpcServices": [ "login", "player" ]
      },
      {
        "Transport": "kcp",
        "Serializer": "memorypack",
        "Host": "127.0.0.1",
        "Port": 20001,
        "ReliablePush": false,
        "RpcServices": [ "battle" ]
      }
    ]
  },
  "Agar": {
    "Persistence": {
      "Postgres": {
        "ConnectionStringName": "AgarGamePostgres"
      },
      "Redis": {
        "ConnectionStringName": "AgarGameRedis",
        "KeyPrefix": "agar"
      }
    }
  }
}
