{
  "ConnectionStrings": {
    "LakonaClusterPostgres": "Host=postgres;Port=5432;Database=lakona-game;Username=lakona-game;Password=lakona-game_dev_password",
    "AgarGamePostgres": "Host=postgres;Port=5432;Database=agar-game;Username=agar;Password=agar_dev_password"
  },
  "Lakona": {
    "Node": {
      "Id": "gateway-1"
    },
    "ActorHosts": [ "user", "matchmaking", "leaderboard", "room" ],
    "Cluster": {
      "Endpoint": "tcp://127.0.0.1:21001",
      "Serializer": "memorypack",
      "Seeds": [ "tcp://127.0.0.1:21001" ]
    },
    "Actors": {
      "CallTimeoutSeconds": 5,
      "SlowMessageThresholdSeconds": 1
    },
    "Sessions": {
      "ResumeWindowSeconds": 60,
      "Cleanup": {
        "IntervalSeconds": 30
      }
    },
    "Hotfix": {
      "DebugWatcher": "On"
    },
    "Observability": {
      "Logging": {
        "Categories": {
          "Server.App": "Trace",
          "Server.Hotfix": "Trace",
          "Lakona.Game.Hotfix": "Information",
          "Lakona.Rpc.Server.Request": "Debug"
        }
      }
    },
    "Endpoints": [
      {
        "Transport": "websocket",
        "Serializer": "memorypack",
        "Host": "127.0.0.1",
        "Port": 20000,
        "Path": "/ws",
        "ReliablePush": true,
        "RpcServices": [ "login", "player" ]
      },
      {
        "Transport": "kcp",
        "Serializer": "memorypack",
        "Host": "127.0.0.1",
        "Port": 20001,
        "ReliablePush": false,
        "RpcServices": [ "battle" ]
      }
    ]
  },
  "Agar": {
    "Persistence": {
      "Provider": "postgres",
      "ConnectionStringName": "AgarGamePostgres"
    }
  }
}
