{
  "Lakona": {
    "Node": {
      "Id": "dev-1"
    },
    "ActorHosts": [ "chatRoom" ],
    "Sessions": {
      "ResumeWindowSeconds": 60,
      "Cleanup": {
        "IntervalSeconds": 30
      }
    },
    "Hotfix": {
      "DebugWatcher": "On"
    },
    "Management": {
      "Http": {
        "Host": "127.0.0.1",
        "Port": 20080
      }
    },
    "Health": {
      "Enabled": true,
      "RequireLoopback": true
    },
    "Observability": {
      "LocalAdmin": {
        "Enabled": true,
        "RequireLoopback": true
      },
      "Logging": {
        "Categories": {
          "Lakona.Game.Hotfix": "Information",
          "Lakona.Rpc.Server.Request": "Debug"
        }
      }
    },
    "Endpoints": [
      {
        "Transport": "websocket",
        "Serializer": "memorypack",
        "Host": "127.0.0.1",
        "Port": 20000,
        "Path": "/ws",
        "ReliablePush": true,
        "RpcServices": [ "login", "chat" ]
      }
    ]
  }
}
