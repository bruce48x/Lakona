{
  "Lakona": {
    "Node": {
      "Id": "dev-1",
      "Roles": [ "chat" ]
    },
    "Sessions": {
      "ResumeWindowSeconds": 60,
      "Cleanup": {
        "IntervalSeconds": 30
      }
    },
    "Hotfix": {
      "DebugWatcher": "On"
    },
    "Management": {
      "Http": {
        "Host": "127.0.0.1",
        "Port": 20080
      },
      "Admin": {
        "Enabled": true,
        "RequireLoopback": true
      }
    },
    "Health": {
      "Enabled": true,
      "RequireLoopback": true
    },
    "Endpoints": [
      {
        "Transport": "websocket",
        "Serializer": "memorypack",
        "Host": "127.0.0.1",
        "Port": 20000,
        "Path": "/ws",
        "ReliablePush": true,
        "RpcServices": [ "login", "chat" ]
      }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Lakona.Game.Hotfix": "Information",
      "Lakona.Rpc.Server.Request": "Trace"
    }
  }
}
