{
  "Lakona": {
    "Node": {
      "Id": "dev-1"
    },
    "Sessions": {
      "Cleanup": {
        "DisconnectedRetentionSeconds": 30
      }
    },
    "Hotfix": {
      "DebugWatcher": "On"
    },
    "Endpoints": [
      {
        "Transport": "websocket",
        "Serializer": "memorypack",
        "Host": "127.0.0.1",
        "Port": 20000,
        "Path": "/ws",
        "RpcServices": [ "login", "chat" ]
      }
    ]
  }
}
