<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Lakona.Game.LoadTesting/Lakona.Game.LoadTesting.csproj" />
    <Compile Include="$(RecorderBaselineFile)" Link="BaselineRecorder.cs" Condition="'$(RecorderBaselineFile)' != ''" />
  </ItemGroup>
  <Target Name="RequireBaseline" BeforeTargets="CoreCompile" Condition="!Exists('$(RecorderBaselineFile)')">
    <Error Text="Run benchmarks/load-recording/run.ps1 to extract the pinned baseline recorder." />
  </Target>
</Project>
