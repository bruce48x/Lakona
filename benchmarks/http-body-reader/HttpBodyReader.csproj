<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <Compile Include="$(ReaderSourceDirectory)/BaselineReader.cs" Link="BaselineReader.cs" />
    <Compile Include="$(ReaderSourceDirectory)/CandidateReader.cs" Link="CandidateReader.cs" />
  </ItemGroup>
  <Target Name="RequireSources" BeforeTargets="CoreCompile" Condition="!Exists('$(ReaderSourceDirectory)/BaselineReader.cs')">
    <Error Text="Run benchmarks/http-body-reader/run.ps1 to extract the actual reader methods." />
  </Target>
</Project>
