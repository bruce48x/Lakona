{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lakona.dev/schemas/framework-benchmark/adapter-manifest-v1.json",
  "type": "object",
  "required": [ "schemaVersion", "framework", "revision", "runtime", "buildMode", "licenseUrl", "supportedWorkloads", "metadata", "servers", "driver" ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "framework": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "runtime": { "type": "string", "minLength": 1 },
    "buildMode": { "type": "string", "minLength": 1 },
    "licenseUrl": { "type": "string", "format": "uri" },
    "supportedWorkloads": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
    "metadata": { "type": "object", "additionalProperties": { "type": "string" } },
    "servers": { "type": "array", "minItems": 1 },
    "driver": { "type": "object" }
  },
  "additionalProperties": false
}
