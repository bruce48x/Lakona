{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lakona.dev/schemas/framework-benchmark/suite-v1.json",
  "type": "object",
  "required": [ "schemaVersion", "id", "frameworks", "workloads", "payloadSizes", "concurrency", "seed", "timing", "histogram" ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "id": { "type": "string", "minLength": 1 },
    "frameworks": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "workloads": { "type": "array", "minItems": 1, "items": { "enum": [ "frontdoor.echo", "cluster.direct", "cluster.routed" ] }, "uniqueItems": true },
    "payloadSizes": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "concurrency": { "type": "array", "minItems": 1, "items": { "type": "integer", "minimum": 1 }, "uniqueItems": true },
    "seed": { "type": "integer" },
    "timing": { "$ref": "#/$defs/timing" },
    "histogram": { "$ref": "#/$defs/histogram" }
  },
  "additionalProperties": false,
  "$defs": {
    "timing": {
      "type": "object",
      "required": [ "startupTimeoutMilliseconds", "readinessTimeoutMilliseconds", "warmupMilliseconds", "measurementMilliseconds", "requestTimeoutMilliseconds", "drainTimeoutMilliseconds", "shutdownTimeoutMilliseconds" ],
      "additionalProperties": false,
      "properties": {
        "startupTimeoutMilliseconds": { "type": "integer", "minimum": 1 },
        "readinessTimeoutMilliseconds": { "type": "integer", "minimum": 1 },
        "warmupMilliseconds": { "type": "integer", "minimum": 0 },
        "measurementMilliseconds": { "type": "integer", "minimum": 1 },
        "requestTimeoutMilliseconds": { "type": "integer", "minimum": 1 },
        "drainTimeoutMilliseconds": { "type": "integer", "minimum": 1 },
        "shutdownTimeoutMilliseconds": { "type": "integer", "minimum": 1 }
      }
    },
    "histogram": {
      "type": "object",
      "required": [ "unit", "lowestDiscernibleValue", "highestTrackableValue", "significantDigits" ],
      "additionalProperties": false,
      "properties": {
        "unit": { "const": "microseconds" },
        "lowestDiscernibleValue": { "type": "integer", "minimum": 1 },
        "highestTrackableValue": { "type": "integer", "minimum": 2 },
        "significantDigits": { "type": "integer", "minimum": 1, "maximum": 5 }
      }
    }
  }
}
