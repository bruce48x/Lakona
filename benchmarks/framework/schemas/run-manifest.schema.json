{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lakona.dev/schemas/framework-benchmark/run-manifest-v1.json",
  "type": "object",
  "required": [ "schemaVersion", "runId", "suiteId", "profile", "mode", "status", "startedAt" ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "runId": { "type": "string", "minLength": 1 },
    "suiteId": { "type": "string", "minLength": 1 },
    "profile": { "const": "local-dev" },
    "mode": { "const": "native" },
    "status": { "enum": [ "running", "complete", "incomplete" ] },
    "startedAt": { "type": "string", "format": "date-time" },
    "finishedAt": { "type": [ "string", "null" ], "format": "date-time" },
    "toolError": { "type": [ "string", "null" ] }
  },
  "additionalProperties": false
}
