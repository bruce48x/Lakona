<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <UseAppHost>false</UseAppHost>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <LakonaProjectRole>ServerApp</LakonaProjectRole>
    <LakonaBuildTag>FrameworkBenchmarkNativeV2</LakonaBuildTag>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="LakonaProjectRole" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    <ProjectReference Include="../FrameworkBenchmark.Lakona.Contracts/FrameworkBenchmark.Lakona.Contracts.csproj" />
    <ProjectReference Include="../FrameworkBenchmark.Lakona.Peers/FrameworkBenchmark.Lakona.Peers.csproj" />
    <ProjectReference Include="../../../../../src/Lakona.Game.Clustering.Redis/Lakona.Game.Clustering.Redis.csproj" />
    <ProjectReference Include="../../../../../src/Lakona.Game.Server/Lakona.Game.Server.csproj" />
    <ProjectReference Include="../../../../../src/Lakona.Game.Server.Hotfix.Generators/Lakona.Game.Server.Hotfix.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
    <ProjectReference Include="../../../../../src/Lakona.Rpc.Analyzers/Lakona.Rpc.Analyzers.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
    <ProjectReference Include="../../../../../src/Lakona.Rpc.Serializer.MemoryPack/Lakona.Rpc.Serializer.MemoryPack.csproj" />
    <ProjectReference Include="../../../../../src/Lakona.Rpc.Transport.Tcp/Lakona.Rpc.Transport.Tcp.csproj" />
    <ProjectReference Include="../../../../../src/Lakona.Rpc.Transport.WebSocket/Lakona.Rpc.Transport.WebSocket.csproj" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LakonaBuildTag</_Parameter1>
      <_Parameter2>$(LakonaBuildTag)</_Parameter2>
    </AssemblyAttribute>
    <InternalsVisibleTo Include="Server.Hotfix" />
  </ItemGroup>
</Project>
