<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AssemblyName>Server.Hotfix</AssemblyName>
    <LakonaProjectRole>Hotfix</LakonaProjectRole>
    <LakonaBuildTag>FrameworkBenchmarkNativeV2</LakonaBuildTag>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="LakonaProjectRole" />
    <ProjectReference Include="../FrameworkBenchmark.Lakona.Server/FrameworkBenchmark.Lakona.Server.csproj" />
    <ProjectReference Include="../../../../../src/Lakona.Game.Server.Hotfix.Generators/Lakona.Game.Server.Hotfix.Generators.csproj" ReferenceOutputAssembly="false" OutputItemType="Analyzer" PrivateAssets="all" />
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>LakonaBuildTag</_Parameter1>
      <_Parameter2>$(LakonaBuildTag)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <Target Name="CopyBenchmarkHotfix" AfterTargets="Build">
    <PropertyGroup>
      <BenchmarkHotfixRoot>$(MSBuildProjectDirectory)/../FrameworkBenchmark.Lakona.Server/bin/$(Configuration)/$(TargetFramework)/hotfix/</BenchmarkHotfixRoot>
      <BenchmarkHotfixOutput>$(BenchmarkHotfixRoot)versions/benchmark/</BenchmarkHotfixOutput>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath);$(ProjectDepsFilePath)" DestinationFolder="$(BenchmarkHotfixOutput)" />
    <WriteLinesToFile File="$(BenchmarkHotfixRoot)current.txt" Lines="benchmark" Overwrite="true" />
  </Target>
</Project>
