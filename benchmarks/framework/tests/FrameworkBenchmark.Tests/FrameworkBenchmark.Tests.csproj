<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.0.1" />
    <PackageReference Include="xunit.v3" Version="3.2.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/FrameworkBenchmark.Contracts/FrameworkBenchmark.Contracts.csproj" />
    <ProjectReference Include="../../src/FrameworkBenchmark.Coordinator/FrameworkBenchmark.Coordinator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../fixtures/**/*"
          Link="fixtures/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../schemas/**/*"
          Link="schemas/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../suites/**/*"
          Link="suites/%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/FrameworkBenchmark.Contracts/FrameworkBenchmark.Contracts.csproj"
          Link="src/FrameworkBenchmark.Contracts/FrameworkBenchmark.Contracts.csproj"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../src/FrameworkBenchmark.Coordinator/FrameworkBenchmark.Coordinator.csproj"
          Link="src/FrameworkBenchmark.Coordinator/FrameworkBenchmark.Coordinator.csproj"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
