<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>BusinessLogic.Tests</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable><IsPackable>false</IsPackable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Lakona.Game.Server/Lakona.Game.Server.csproj" />
    <Compile Include="$(PopulationBaselineDirectory)/BaselineRegistry.cs" Link="BaselineRegistry.cs" />
    <Compile Include="$(PopulationBaselineDirectory)/BaselineTelemetry.cs" Link="BaselineTelemetry.cs" />
    <Compile Include="$(PopulationBaselineDirectory)/ProbeRegistry.cs" Link="ProbeRegistry.cs" />
  </ItemGroup>
  <Target Name="RequireBaseline" BeforeTargets="CoreCompile" Condition="!Exists('$(PopulationBaselineDirectory)/BaselineRegistry.cs')">
    <Error Text="Run benchmarks/session-population/run.ps1 to extract the baseline sources." />
  </Target>
</Project>
