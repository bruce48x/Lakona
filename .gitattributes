* text=auto eol=lf

# Keep common source and project files normalized as text.
*.cs text eol=lf
*.csproj text eol=lf
*.props text eol=lf
*.targets text eol=lf
*.sln text eol=lf
*.slnx text eol=lf
*.json text eol=lf
*.jsonc text eol=lf
*.xml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.ps1 text eol=lf
*.sh text eol=lf

# Unity and Godot assets that are text-serialized should remain diffable.
*.asmdef text eol=lf
*.asset text eol=lf
*.controller text eol=lf
*.mat text eol=lf
*.meta text eol=lf
*.prefab text eol=lf
*.scene text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.unity text eol=lf

# Large binary assets used by Unity/Godot samples.
