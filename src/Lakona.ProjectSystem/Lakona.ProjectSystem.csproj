<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <PackageId>Lakona.ProjectSystem</PackageId>
    <Version>0.5.6</Version>
    <Description>Shared Lakona project inspection, creation planning, rendering, and transactional execution.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Generation\Rendering\Client\TemplateAssets\NuGetForUnity.4.5.0.zip" LogicalName="Lakona.Tool.Rendering.Client.TemplateAssets.NuGetForUnity.4.5.0.zip" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lakona.Tool" />
    <InternalsVisibleTo Include="Lakona.Tool.Tests" />
    <InternalsVisibleTo Include="Lakona.ProjectSystem.Tests" />
  </ItemGroup>

  <PropertyGroup>
    <GeneratedProjectPackageVersionsFile>$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\GeneratedProjectPackageVersions.g.cs</GeneratedProjectPackageVersionsFile>
  </PropertyGroup>

  <Target Name="GenerateProjectPackageVersions" BeforeTargets="CoreCompile">
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Game.Abstractions\Lakona.Game.Abstractions.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaGameAbstractionsPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Game.Client\Lakona.Game.Client.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaGameClientPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Game.LoadTesting\Lakona.Game.LoadTesting.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaGameLoadTestingPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Game.Server\Lakona.Game.Server.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaGameServerPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Game.Cluster.Rpc.Transport.Tcp\Lakona.Game.Cluster.Rpc.Transport.Tcp.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaGameClusterRpcTransportTcpPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Game.Cluster.Rpc.Serializer.Json\Lakona.Game.Cluster.Rpc.Serializer.Json.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaGameClusterRpcSerializerJsonPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Game.Cluster.Rpc.Serializer.MemoryPack\Lakona.Game.Cluster.Rpc.Serializer.MemoryPack.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaGameClusterRpcSerializerMemoryPackPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Game.Server.Hotfix.Abstractions\Lakona.Game.Server.Hotfix.Abstractions.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaGameServerHotfixAbstractionsPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Rpc.Core\Lakona.Rpc.Core.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaRpcCorePackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Rpc.Server\Lakona.Rpc.Server.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaRpcServerPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Rpc.Client\Lakona.Rpc.Client.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaRpcClientPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Rpc.Transport.Tcp\Lakona.Rpc.Transport.Tcp.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaRpcTransportTcpPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Rpc.Transport.WebSocket\Lakona.Rpc.Transport.WebSocket.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaRpcTransportWebSocketPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Rpc.Transport.Kcp\Lakona.Rpc.Transport.Kcp.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaRpcTransportKcpPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Rpc.Serializer.Json\Lakona.Rpc.Serializer.Json.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaRpcSerializerJsonPackageVersion" />
    </XmlPeek>
    <XmlPeek XmlInputPath="$(MSBuildProjectDirectory)\..\Lakona.Rpc.Serializer.MemoryPack\Lakona.Rpc.Serializer.MemoryPack.csproj" Query="/Project/PropertyGroup/Version/text()">
      <Output TaskParameter="Result" PropertyName="LakonaRpcSerializerMemoryPackPackageVersion" />
    </XmlPeek>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(GeneratedProjectPackageVersionsFile)'))" />

    <ItemGroup>
      <GeneratedProjectPackageVersionsLine Include="// &lt;auto-generated /&gt;" />
      <GeneratedProjectPackageVersionsLine Include="internal static partial class GeneratedProjectPackageVersions" />
      <GeneratedProjectPackageVersionsLine Include="{" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaGameAbstractions = &quot;$(LakonaGameAbstractionsPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaGameClient = &quot;$(LakonaGameClientPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaGameLoadTesting = &quot;$(LakonaGameLoadTestingPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaGameServer = &quot;$(LakonaGameServerPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaGameClusterRpcTransportTcp = &quot;$(LakonaGameClusterRpcTransportTcpPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaGameClusterRpcSerializerJson = &quot;$(LakonaGameClusterRpcSerializerJsonPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaGameClusterRpcSerializerMemoryPack = &quot;$(LakonaGameClusterRpcSerializerMemoryPackPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaGameServerHotfixAbstractions = &quot;$(LakonaGameServerHotfixAbstractionsPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaRpcCore = &quot;$(LakonaRpcCorePackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaRpcServer = &quot;$(LakonaRpcServerPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaRpcClient = &quot;$(LakonaRpcClientPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaRpcTransportTcp = &quot;$(LakonaRpcTransportTcpPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaRpcTransportWebSocket = &quot;$(LakonaRpcTransportWebSocketPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaRpcTransportKcp = &quot;$(LakonaRpcTransportKcpPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaRpcSerializerJson = &quot;$(LakonaRpcSerializerJsonPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="    public const string LakonaRpcSerializerMemoryPack = &quot;$(LakonaRpcSerializerMemoryPackPackageVersion)&quot;%3B" />
      <GeneratedProjectPackageVersionsLine Include="}" />
    </ItemGroup>

    <WriteLinesToFile File="$(GeneratedProjectPackageVersionsFile)" Lines="@(GeneratedProjectPackageVersionsLine)" Overwrite="true" />

    <ItemGroup>
      <Compile Include="$(GeneratedProjectPackageVersionsFile)" Link="GeneratedProjectPackageVersions.g.cs" />
    </ItemGroup>
  </Target>
</Project>
