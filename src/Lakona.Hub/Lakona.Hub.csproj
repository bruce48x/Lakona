<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <Version>0.11.8</Version>
    <ApplicationTitle>Lakona Hub</ApplicationTitle>
    <ApplicationIcon>Assets\lakona-hub.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <PublishAot Condition="'$(Configuration)' == 'Release' and '$(DesignTimeBuild)' != 'true'">true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings>
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <ILLinkTreatWarningsAsErrors>true</ILLinkTreatWarningsAsErrors>
    <StripSymbols>true</StripSymbols>
  </PropertyGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\lakona-hub.ico" />
    <AvaloniaResource Include="Assets\lakona-hub-2048.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.331" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../Lakona.ProjectSystem/Lakona.ProjectSystem.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lakona.Hub.Tests" />
  </ItemGroup>
</Project>
