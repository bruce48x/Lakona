<Application
    x:Class="Lakona.Hub.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <!-- Every visual surface consumes the same semantic keys on every platform. -->
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Dark">
          <SolidColorBrush x:Key="HubBrush.Window" Color="#0D0F12" />
          <SolidColorBrush x:Key="HubBrush.Sidebar" Color="#101215" />
          <SolidColorBrush x:Key="HubBrush.Surface" Color="#14171B" />
          <SolidColorBrush x:Key="HubBrush.SurfaceRaised" Color="#191C21" />
          <SolidColorBrush x:Key="HubBrush.SurfaceHover" Color="#1D2025" />
          <SolidColorBrush x:Key="HubBrush.SurfaceListHover" Color="#15181C" />
          <SolidColorBrush x:Key="HubBrush.SurfaceSelected" Color="#252219" />
          <SolidColorBrush x:Key="HubBrush.NavSelected" Color="#252219" />
          <SolidColorBrush x:Key="HubBrush.NavSelectedHover" Color="#2B271C" />
          <SolidColorBrush x:Key="HubBrush.NavSelectedPressed" Color="#211E16" />
          <SolidColorBrush x:Key="HubBrush.SurfaceFeedback" Color="#1D2025" />
          <SolidColorBrush x:Key="HubBrush.SurfaceAccentMuted" Color="#272319" />
          <SolidColorBrush x:Key="HubBrush.Overlay" Color="#B8000000" />
          <SolidColorBrush x:Key="HubBrush.Accent" Color="#EFBE3E" />
          <SolidColorBrush x:Key="HubBrush.AccentHover" Color="#F7CE62" />
          <SolidColorBrush x:Key="HubBrush.AccentPressed" Color="#DBA924" />
          <!-- Text on surfaces: keep brand gold on dark; light uses HubBrush.TextAccent. -->
          <SolidColorBrush x:Key="HubBrush.TextAccent" Color="#EFBE3E" />
          <SolidColorBrush x:Key="HubBrush.TextPrimary" Color="#F2F1ED" />
          <SolidColorBrush x:Key="HubBrush.TextSecondary" Color="#ECEAE3" />
          <SolidColorBrush x:Key="HubBrush.TextMuted" Color="#B0AFAA" />
          <SolidColorBrush x:Key="HubBrush.TextOnAccent" Color="#15120A" />
          <SolidColorBrush x:Key="HubBrush.TextError" Color="#E87777" />
          <SolidColorBrush x:Key="HubBrush.Danger" Color="#B3261E" />
          <SolidColorBrush x:Key="HubBrush.BorderSidebar" Color="#272B31" />
          <SolidColorBrush x:Key="HubBrush.BorderCard" Color="#30353D" />
          <SolidColorBrush x:Key="HubBrush.BorderSubtle" Color="#292D34" />
          <SolidColorBrush x:Key="HubBrush.BorderDefault" Color="#484D55" />
          <SolidColorBrush x:Key="HubBrush.BorderAccentMuted" Color="#65552F" />
          <SolidColorBrush x:Key="HubBrush.BorderAccent" Color="#B68E2F" />
          <SolidColorBrush x:Key="HubBrush.BorderInteraction" Color="#EFBE3E" />
          <SolidColorBrush x:Key="HubBrush.WindowBorderActive" Color="#C7EFBE3E" />
          <SolidColorBrush x:Key="HubBrush.WindowBorderInactive" Color="#52EFBE3E" />
          <LinearGradientBrush x:Key="HubBrush.SidebarGradient" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#14171B" Offset="0" />
            <GradientStop Color="#0E1013" Offset="1" />
          </LinearGradientBrush>
          <RadialGradientBrush x:Key="HubBrush.DialogGradient">
            <GradientStop Color="#191C21" Offset="0" />
            <GradientStop Color="#111316" Offset="1" />
          </RadialGradientBrush>
          <Color x:Key="SystemAccentColor">#EFBE3E</Color>
          <Color x:Key="SystemAccentColorLight1">#F7CE62</Color>
          <Color x:Key="SystemAccentColorDark1">#B68E2F</Color>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
          <!-- Neutral canvas, white surfaces, and dark ink keep light mode readable. -->
          <SolidColorBrush x:Key="HubBrush.Window" Color="#F4F5F7" />
          <SolidColorBrush x:Key="HubBrush.Sidebar" Color="#ECEEF2" />
          <SolidColorBrush x:Key="HubBrush.Surface" Color="#FFFFFF" />
          <SolidColorBrush x:Key="HubBrush.SurfaceRaised" Color="#ECEEF2" />
          <SolidColorBrush x:Key="HubBrush.SurfaceHover" Color="#E2E5EA" />
          <SolidColorBrush x:Key="HubBrush.SurfaceListHover" Color="#E9ECF1" />
          <SolidColorBrush x:Key="HubBrush.SurfaceSelected" Color="#FFF0CB" />
          <SolidColorBrush x:Key="HubBrush.NavSelected" Color="#FFD782" />
          <SolidColorBrush x:Key="HubBrush.NavSelectedHover" Color="#FFE0A0" />
          <SolidColorBrush x:Key="HubBrush.NavSelectedPressed" Color="#FFCD68" />
          <SolidColorBrush x:Key="HubBrush.SurfaceFeedback" Color="#FFFAED" />
          <SolidColorBrush x:Key="HubBrush.SurfaceAccentMuted" Color="#FFF5DE" />
          <SolidColorBrush x:Key="HubBrush.Overlay" Color="#73000000" />
          <SolidColorBrush x:Key="HubBrush.Accent" Color="#FFB824" />
          <SolidColorBrush x:Key="HubBrush.AccentHover" Color="#FFC64A" />
          <SolidColorBrush x:Key="HubBrush.AccentPressed" Color="#F5AC18" />
          <!-- Mango yellow fills retain their warm hue in every state; text and interaction borders use black. -->
          <SolidColorBrush x:Key="HubBrush.TextAccent" Color="#000000" />
          <SolidColorBrush x:Key="HubBrush.TextPrimary" Color="#20242C" />
          <SolidColorBrush x:Key="HubBrush.TextSecondary" Color="#3E4652" />
          <SolidColorBrush x:Key="HubBrush.TextMuted" Color="#596273" />
          <SolidColorBrush x:Key="HubBrush.TextOnAccent" Color="#000000" />
          <SolidColorBrush x:Key="HubBrush.TextError" Color="#A52A2A" />
          <SolidColorBrush x:Key="HubBrush.Danger" Color="#B3261E" />
          <SolidColorBrush x:Key="HubBrush.BorderSidebar" Color="#C5CBD3" />
          <SolidColorBrush x:Key="HubBrush.BorderCard" Color="#BCC3CD" />
          <SolidColorBrush x:Key="HubBrush.BorderSubtle" Color="#CFD4DC" />
          <SolidColorBrush x:Key="HubBrush.BorderDefault" Color="#7A8492" />
          <SolidColorBrush x:Key="HubBrush.BorderAccentMuted" Color="#000000" />
          <SolidColorBrush x:Key="HubBrush.BorderAccent" Color="#000000" />
          <SolidColorBrush x:Key="HubBrush.BorderInteraction" Color="#000000" />
          <SolidColorBrush x:Key="HubBrush.WindowBorderActive" Color="#A6000000" />
          <SolidColorBrush x:Key="HubBrush.WindowBorderInactive" Color="#33000000" />
          <LinearGradientBrush x:Key="HubBrush.SidebarGradient" StartPoint="0%,0%" EndPoint="0%,100%">
            <GradientStop Color="#ECEEF2" Offset="0" />
            <GradientStop Color="#E5E8ED" Offset="1" />
          </LinearGradientBrush>
          <RadialGradientBrush x:Key="HubBrush.DialogGradient">
            <GradientStop Color="#FFFFFF" Offset="0" />
            <GradientStop Color="#F4F5F7" Offset="1" />
          </RadialGradientBrush>
          <Color x:Key="SystemAccentColor">#FFB824</Color>
          <Color x:Key="SystemAccentColorLight1">#FFC64A</Color>
          <Color x:Key="SystemAccentColorDark1">#000000</Color>
        </ResourceDictionary>
      </ResourceDictionary.ThemeDictionaries>

    <!-- Surface depth hierarchy. -->
    <BoxShadows x:Key="HubShadow.Card">0 3 12 0 #24000000</BoxShadows>
    <BoxShadows x:Key="HubShadow.Dialog">0 16 40 0 #52000000</BoxShadows>
    <BoxShadows x:Key="HubShadow.Toast">0 8 24 0 #40000000</BoxShadows>
    <BoxShadows x:Key="HubShadow.WindowActive">0 8 24 2 #59000000</BoxShadows>
    <BoxShadows x:Key="HubShadow.WindowInactive">0 6 20 1 #40000000</BoxShadows>

    <x:Double x:Key="HubFont.Metadata">12</x:Double>
    <x:Double x:Key="HubFont.Caption">13</x:Double>
    <x:Double x:Key="HubFont.Control">14</x:Double>
    <x:Double x:Key="HubFont.Body">14</x:Double>
    <x:Double x:Key="HubFont.Status">14</x:Double>
    <x:Double x:Key="HubFont.Navigation">14</x:Double>
    <x:Double x:Key="HubFont.Action">15</x:Double>
    <x:Double x:Key="HubFont.HeroAction">16</x:Double>
    <x:Double x:Key="HubFont.SectionTitle">18</x:Double>
    <x:Double x:Key="HubFont.CardTitle">19</x:Double>
    <x:Double x:Key="HubFont.DialogTitle">22</x:Double>
    <x:Double x:Key="HubFont.PageTitle">28</x:Double>

    <CornerRadius x:Key="HubRadius.Small">6</CornerRadius>
    <CornerRadius x:Key="HubRadius.Control">8</CornerRadius>
    <CornerRadius x:Key="HubRadius.Icon">10</CornerRadius>
    <CornerRadius x:Key="HubRadius.Card">12</CornerRadius>
    <CornerRadius x:Key="HubRadius.Dialog">14</CornerRadius>
    <CornerRadius x:Key="HubRadius.Window">14</CornerRadius>

    <Thickness x:Key="HubInset.Action">20,10</Thickness>
    <Thickness x:Key="HubInset.SecondaryAction">19,9</Thickness>
    <Thickness x:Key="HubInset.Field">12,8</Thickness>
    <Thickness x:Key="HubInset.Card">22</Thickness>
    <Thickness x:Key="HubInset.Dialog">26</Thickness>
    <Thickness x:Key="HubInset.DialogDetail">12,9</Thickness>
    <Thickness x:Key="HubInset.DialogActions">0,20,0,0</Thickness>
    <Thickness x:Key="HubInset.Nav">14,10</Thickness>
    <Thickness x:Key="HubInset.ActionButton">14,8</Thickness>
    <Thickness x:Key="HubInset.Chip">14,7</Thickness>
    <Thickness x:Key="HubInset.DialogAction">18,9</Thickness>

    <!-- Control sizing and touch targets. -->
    <x:Double x:Key="HubControl.Height.Button">44</x:Double>
    <x:Double x:Key="HubControl.Height.Hero">52</x:Double>
    <x:Double x:Key="HubControl.Height.Action">42</x:Double>
    <x:Double x:Key="HubControl.Height.Field">44</x:Double>
    <x:Double x:Key="HubControl.Height.Search">38</x:Double>
    <x:Double x:Key="HubControl.Height.Chip">34</x:Double>
    <x:Double x:Key="HubControl.Height.Badge">28</x:Double>
    <x:Double x:Key="HubControl.Height.TableHeader">34</x:Double>
    <x:Double x:Key="HubControl.Height.DialogAction">42</x:Double>
    <x:Double x:Key="HubControl.Height.FormAction">48</x:Double>
    <x:Double x:Key="HubControl.MinWidth.Hero">224</x:Double>
    <x:Double x:Key="HubControl.MinWidth.DialogSecondary">112</x:Double>
    <x:Double x:Key="HubControl.MinWidth.DialogPrimary">184</x:Double>
    <x:Double x:Key="HubControl.Width.Browse">84</x:Double>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
