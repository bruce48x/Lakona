<Application
    x:Class="Lakona.Hub.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  RequestedThemeVariant="Dark">
  <Application.Resources>
    <!-- Semantic visual tokens shared by every Hub surface. -->
    <SolidColorBrush x:Key="HubBrush.Window" Color="#0B0C0D" />
    <SolidColorBrush x:Key="HubBrush.Sidebar" Color="#0E0F10" />
    <SolidColorBrush x:Key="HubBrush.Surface" Color="#111213" />
    <SolidColorBrush x:Key="HubBrush.SurfaceRaised" Color="#171713" />
    <SolidColorBrush x:Key="HubBrush.SurfaceHover" Color="#181816" />
    <SolidColorBrush x:Key="HubBrush.SurfaceListHover" Color="#121313" />
    <SolidColorBrush x:Key="HubBrush.SurfaceSelected" Color="#1B1B18" />
    <SolidColorBrush x:Key="HubBrush.SurfaceFeedback" Color="#20201B" />
    <SolidColorBrush x:Key="HubBrush.SurfaceAccentMuted" Color="#211F17" />
    <SolidColorBrush x:Key="HubBrush.Overlay" Color="#B8000000" />
    <SolidColorBrush x:Key="HubBrush.Accent" Color="#EFBE3E" />
    <SolidColorBrush x:Key="HubBrush.AccentHover" Color="#F7CE62" />
    <SolidColorBrush x:Key="HubBrush.TextPrimary" Color="#F2F1ED" />
    <SolidColorBrush x:Key="HubBrush.TextSecondary" Color="#E6E4DE" />
    <SolidColorBrush x:Key="HubBrush.TextMuted" Color="#9C9B97" />
    <SolidColorBrush x:Key="HubBrush.TextOnAccent" Color="#15120A" />
    <SolidColorBrush x:Key="HubBrush.TextError" Color="#E87777" />
    <SolidColorBrush x:Key="HubBrush.Danger" Color="#B3261E" />
    <SolidColorBrush x:Key="HubBrush.BorderSidebar" Color="#2A2A27" />
    <SolidColorBrush x:Key="HubBrush.BorderCard" Color="#34342F" />
    <SolidColorBrush x:Key="HubBrush.BorderSubtle" Color="#33332F" />
    <SolidColorBrush x:Key="HubBrush.BorderDefault" Color="#4A4944" />
    <SolidColorBrush x:Key="HubBrush.BorderAccentMuted" Color="#6F5923" />
    <SolidColorBrush x:Key="HubBrush.BorderAccent" Color="#B68E2F" />

    <x:Double x:Key="HubFont.Metadata">11</x:Double>
    <x:Double x:Key="HubFont.Caption">12</x:Double>
    <x:Double x:Key="HubFont.Control">13</x:Double>
    <x:Double x:Key="HubFont.Body">14</x:Double>
    <x:Double x:Key="HubFont.Status">15</x:Double>
    <x:Double x:Key="HubFont.Navigation">16</x:Double>
    <x:Double x:Key="HubFont.Action">17</x:Double>
    <x:Double x:Key="HubFont.HeroAction">19</x:Double>
    <x:Double x:Key="HubFont.SectionTitle">20</x:Double>
    <x:Double x:Key="HubFont.CardTitle">22</x:Double>
    <x:Double x:Key="HubFont.DialogTitle">24</x:Double>
    <x:Double x:Key="HubFont.PageTitle">38</x:Double>

    <CornerRadius x:Key="HubRadius.Small">6</CornerRadius>
    <CornerRadius x:Key="HubRadius.Control">7</CornerRadius>
    <CornerRadius x:Key="HubRadius.Icon">8</CornerRadius>
    <CornerRadius x:Key="HubRadius.Card">10</CornerRadius>
    <CornerRadius x:Key="HubRadius.Dialog">12</CornerRadius>
    <CornerRadius x:Key="HubRadius.Window">14</CornerRadius>

    <Thickness x:Key="HubInset.Action">24,14</Thickness>
    <Thickness x:Key="HubInset.SecondaryAction">23,13</Thickness>
    <Thickness x:Key="HubInset.Field">14,10</Thickness>
    <Thickness x:Key="HubInset.Card">24</Thickness>
    <Thickness x:Key="HubInset.Dialog">24</Thickness>
    <Thickness x:Key="HubInset.DialogDetail">12,9</Thickness>
    <Thickness x:Key="HubInset.DialogActions">0,18,0,0</Thickness>
    <Color x:Key="SystemAccentColor">#EFBE3E</Color>
    <Color x:Key="SystemAccentColorLight1">#F7CE62</Color>
    <Color x:Key="SystemAccentColorDark1">#B68E2F</Color>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
  </Application.Styles>
</Application>
