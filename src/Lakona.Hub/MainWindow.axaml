<Window
    x:Class="Lakona.Hub.MainWindow"
    x:DataType="local:MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:applications="using:Lakona.Hub.Applications"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:local="using:Lakona.Hub"
    Title="Lakona Hub"
    Icon="/Assets/lakona-hub-2048.png"
    Width="1440"
    Height="1024"
    MinWidth="1000"
    MinHeight="800"
    CanResize="True"
    Background="Transparent"
    FontFamily="Microsoft YaHei UI"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="#F2F1ED" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="#9C9B97" />
    </Style>
    <Style Selector="TextBlock.gold">
      <Setter Property="Foreground" Value="#EFBE3E" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button > StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="#EFBE3E" />
      <Setter Property="Foreground" Value="#15120A" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="24,14" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary.hero">
      <Setter Property="Height" Value="74" />
      <Setter Property="MinWidth" Value="242" />
      <Setter Property="FontSize" Value="19" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F7CE62" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#E6E4DE" />
      <Setter Property="BorderBrush" Value="#B68E2F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="23,13" />
      <Setter Property="FontSize" Value="17" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.secondary.hero">
      <Setter Property="Height" Value="74" />
      <Setter Property="MinWidth" Value="258" />
      <Setter Property="FontSize" Value="19" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#171611" />
      <Setter Property="BorderBrush" Value="#EFBE3E" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#B4B2AC" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="20,15" />
      <Setter Property="FontSize" Value="16" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#181816" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="#1B1B18" />
      <Setter Property="Foreground" Value="#EFBE3E" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="#EFBE3E" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
    </Style>
    <Style Selector="Button.server-open">
      <Setter Property="Width" Value="58" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="8,10" />
      <Setter Property="Background" Value="#EFBE3E" />
      <Setter Property="Foreground" Value="#15120A" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.server-open:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#F7CE62" />
    </Style>
    <Style Selector="Button.client-open">
      <Setter Property="MinWidth" Value="142" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="13,9" />
      <Setter Property="Background" Value="#111213" />
      <Setter Property="Foreground" Value="#E8E6E0" />
      <Setter Property="BorderBrush" Value="#66645F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.client-open:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#1A1916" />
      <Setter Property="BorderBrush" Value="#B68E2F" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <Style Selector="ComboBox.server-editor">
      <Setter Property="MinWidth" Value="168" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Background" Value="#111213" />
      <Setter Property="Foreground" Value="#E8E6E0" />
      <Setter Property="BorderBrush" Value="#B68E2F" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="ComboBox.server-editor:pointerover /template/ Border#Background">
      <Setter Property="BorderBrush" Value="#EFBE3E" />
    </Style>
    <Style Selector="TextBox.form-field">
      <Setter Property="Height" Value="52" />
      <Setter Property="Padding" Value="14,10" />
      <Setter Property="Background" Value="#111213" />
      <Setter Property="Foreground" Value="#F2F1ED" />
      <Setter Property="BorderBrush" Value="#4A4944" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="TextBox.form-field:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="#EFBE3E" />
    </Style>
    <Style Selector="ComboBox.form-field">
      <Setter Property="Height" Value="52" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="#111213" />
      <Setter Property="Foreground" Value="#F2F1ED" />
      <Setter Property="BorderBrush" Value="#4A4944" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="15" />
    </Style>
    <Style Selector="ComboBox.form-field:pointerover /template/ Border#Background">
      <Setter Property="BorderBrush" Value="#EFBE3E" />
    </Style>
    <Style Selector="Button.form-browse">
      <Setter Property="Width" Value="92" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Background" Value="#171713" />
      <Setter Property="Foreground" Value="#EFBE3E" />
      <Setter Property="BorderBrush" Value="#6F5923" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
      <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="Button.form-browse:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#211F17" />
      <Setter Property="BorderBrush" Value="#EFBE3E" />
    </Style>
    <Style Selector="Button.back">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#C8C6BF" />
      <Setter Property="BorderBrush" Value="#4A4944" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="7" />
    </Style>
    <Style Selector="Button.back:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#181816" />
      <Setter Property="BorderBrush" Value="#EFBE3E" />
      <Setter Property="Foreground" Value="#EFBE3E" />
    </Style>
    <Style Selector="ListBox.project-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.project-list ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.project-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#121313" />
    </Style>
    <Style Selector="ListBox.project-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="#171712" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="#A9A8A4" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.window-control:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#242421" />
    </Style>
    <Style Selector="Button.window-control.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="#B3261E" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.window-frame">
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.window-frame.maximized">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
  </Window.Styles>

  <Border x:Name="WindowFrame" Classes="window-frame" Background="#0B0C0D" ClipToBounds="True">
  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0" Background="#0E0F10" BorderBrush="#2A2A27" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="190,Auto,*,Auto" Margin="10,22,10,24">
        <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="  /\_/\&#10; ( oᴥo )&#10;  U___U"
                     FontFamily="monospace"
                     FontSize="17"
                     LineHeight="20"
                     HorizontalAlignment="Center"
                     TextAlignment="Center" />
          <TextBlock Text="Lakona Hub"
                     FontSize="22"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     TextAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="12">
          <Button x:Name="ProjectsNavButton" Classes="nav selected" Click="Projects_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <icons:FluentIcon Icon="Folder" IconVariant="Regular" IconSize="Size24" />
              <TextBlock Text="{Binding Localization.Text.Projects}" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="SettingsNavButton" Classes="nav" Click="Settings_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <icons:FluentIcon Icon="Settings" IconVariant="Regular" IconSize="Size24" />
              <TextBlock Text="{Binding Localization.Text.Settings}" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="#2A2A27" BorderThickness="0,1,0,0" Padding="4,24,4,0">
          <Button Classes="nav" Click="Help_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <icons:FluentIcon Icon="QuestionCircle" IconVariant="Regular" IconSize="Size24" />
              <TextBlock Text="{Binding Localization.Text.HelpAndFeedback}" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="56,*" Background="#0B0C0D">
      <Border Grid.Row="0" Background="#0B0C0D" PointerPressed="TitleBar_PointerPressed">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Classes="window-control" Click="Minimize_Click" ToolTip.Tip="{Binding Localization.Text.Minimize}">
            <icons:FluentIcon Icon="Subtract" IconVariant="Regular" IconSize="Size16" />
          </Button>
          <Button Classes="window-control" Click="Maximize_Click" ToolTip.Tip="{Binding Localization.Text.Maximize}">
            <icons:FluentIcon Icon="Square" IconVariant="Regular" IconSize="Size16" />
          </Button>
          <Button Classes="window-control close" Click="Close_Click" ToolTip.Tip="{Binding Localization.Text.Close}">
            <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size20" />
          </Button>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid x:Name="EmptyExperience">
          <StackPanel x:Name="EmptyProjectContent" Spacing="38" HorizontalAlignment="Center" VerticalAlignment="Center">
            <WrapPanel x:Name="EmptyProjectActions" HorizontalAlignment="Center">
              <Button Classes="primary hero" Margin="9" Click="CreateProject_Click">
                <StackPanel Orientation="Horizontal" Spacing="13">
                  <icons:FluentIcon Icon="FolderAdd" IconVariant="Regular" IconSize="Size28" />
                  <TextBlock Text="{Binding Localization.Text.CreateProject}" Foreground="#15120A" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="secondary hero" Margin="9" Click="ImportProject_Click">
                <StackPanel Orientation="Horizontal" Spacing="13">
                  <icons:FluentIcon Icon="FolderArrowRight" IconVariant="Regular" IconSize="Size28" />
                  <TextBlock Text="{Binding Localization.Text.ImportExistingProject}" Foreground="#E6E4DE" FontSize="19" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Center">
              <icons:FluentIcon Icon="CheckmarkCircle" IconVariant="Regular" IconSize="Size24" Foreground="#EFBE3E" />
              <TextBlock x:Name="EmptySdkStatusText" FontSize="15" VerticalAlignment="Center" Margin="15,0,0,0" />
              <Border Width="1" Height="22" Background="#4A4944" Margin="8,0" />
              <TextBlock x:Name="EmptyEnvironmentSummaryText" Classes="muted" FontSize="14" VerticalAlignment="Center" />
            </WrapPanel>
          </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ProjectExperience" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="64,52,36,48">
            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="{Binding Localization.Text.MyProjects}" FontSize="38" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,12" />
              <Button Classes="primary" Margin="0,0,16,12" Click="CreateProject_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <icons:FluentIcon Icon="FolderAdd" IconVariant="Regular" IconSize="Size24" />
                  <TextBlock Text="{Binding Localization.Text.CreateProject}" Foreground="#15120A" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="secondary" Margin="0,0,16,12" Click="ImportProject_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <icons:FluentIcon Icon="FolderArrowRight" IconVariant="Regular" IconSize="Size24" />
                  <TextBlock Text="{Binding Localization.Text.ImportExistingProject}" Foreground="#E6E4DE" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <WrapPanel Margin="0,24,0,0">
              <icons:FluentIcon Icon="CheckmarkCircle" IconVariant="Regular" IconSize="Size24" Foreground="#EFBE3E" />
              <TextBlock x:Name="ProjectSdkStatusText" Classes="muted" FontSize="14" VerticalAlignment="Center" Margin="15,0,0,0" />
              <Border Width="1" Height="22" Background="#4A4944" Margin="8,0" />
              <TextBlock x:Name="ProjectEnvironmentSummaryText" Classes="muted" FontSize="14" VerticalAlignment="Center" />
            </WrapPanel>

            <StackPanel Margin="0,66,0,0" Spacing="0">
              <Grid ColumnDefinitions="1.45*,0.9*,1.0*,0.8*,1.65*,1.15*" Margin="0,0,0,22">
                <TextBlock Grid.Column="0" Text="{Binding Localization.Text.ProjectName}" Classes="muted" FontSize="14" />
                <TextBlock Grid.Column="1" Text="{Binding Localization.Text.EngineVersion}" Classes="muted" FontSize="14" />
                <TextBlock Grid.Column="2" Text="{Binding Localization.Text.LakonaVersion}" Classes="muted" FontSize="14" />
                <TextBlock Grid.Column="3" Text="{Binding Localization.Text.LastOpened}" Classes="muted" FontSize="14" />
                <TextBlock Grid.Column="4" Text="{Binding Localization.Text.OpenServer}" Classes="muted" FontSize="14" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding Localization.Text.OpenClient}" Classes="muted" FontSize="14" HorizontalAlignment="Center" />
              </Grid>

              <Border BorderBrush="#33332F" BorderThickness="0,1,0,0">
                <ListBox x:Name="ProjectList" Classes="project-list" ItemsSource="{Binding Projects}" SelectionChanged="ProjectList_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ProjectListItem">
                      <Border BorderBrush="#33332F" BorderThickness="0,0,0,1" MinHeight="96" Padding="0,20">
                        <Grid ColumnDefinitions="1.45*,0.9*,1.0*,0.8*,1.65*,1.15*">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <icons:FluentIcon Icon="Cube" IconVariant="Regular" IconSize="Size24" Foreground="#EFBE3E" />
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Client}" Classes="muted" FontSize="15" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding LakonaVersion}" Classes="muted" FontSize="15" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding LastOpened}" Classes="muted" FontSize="15" VerticalAlignment="Center" />

                          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ComboBox Classes="server-editor" ItemsSource="{Binding ServerEditors}" SelectedItem="{Binding SelectedServerEditor, Mode=TwoWay}" IsEnabled="{Binding CanOpenServer}" ToolTip.Tip="{Binding ServerOpenToolTip}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="applications:LocalApplicationInstallation">
                                  <StackPanel Orientation="Horizontal" Spacing="9">
                                    <icons:FluentIcon Icon="Code" IconVariant="Regular" IconSize="Size20" Foreground="#EFBE3E" />
                                    <TextBlock Text="{Binding DisplayName}" FontSize="14" VerticalAlignment="Center" />
                                  </StackPanel>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Classes="server-open" Content="{Binding OpenText}" Click="OpenServer_Click" IsEnabled="{Binding CanOpenServer}" ToolTip.Tip="{Binding ServerOpenToolTip}" />
                          </StackPanel>

                          <Button Grid.Column="5" Classes="client-open" Click="OpenClient_Click" IsEnabled="{Binding CanOpenClient}" ToolTip.Tip="{Binding ClientOpenToolTip}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                              <icons:FluentIcon Icon="WindowDevEdit" IconVariant="Regular" IconSize="Size20" />
                              <TextBlock Text="{Binding ClientActionText}" Foreground="{Binding $parent[Button].Foreground}" FontSize="14" />
                            </StackPanel>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="CreateExperience" IsVisible="False" HorizontalScrollBarVisibility="Disabled" DataContext="{Binding CreationForm}">
          <StackPanel x:DataType="local:ProjectCreationForm" Margin="64,44,42,54" MaxWidth="1120" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="18">
              <Button Classes="back" Click="CancelCreateProject_Click" ToolTip.Tip="{Binding Text.BackToProjects}">
                <icons:FluentIcon Icon="ArrowLeft" IconVariant="Regular" IconSize="Size24" />
              </Button>
              <StackPanel Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="{Binding Text.CreateProject}" FontSize="38" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Text.CreateDescription}" Classes="muted" FontSize="15" />
              </StackPanel>
            </StackPanel>

            <Grid ColumnDefinitions="1*,42,1*" Margin="0,42,0,0">
              <StackPanel Grid.Column="0" Spacing="0">
                <TextBlock Text="{Binding Text.BasicInformation}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />

                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding Text.ProjectName}" FontSize="14" FontWeight="SemiBold" />
                  <TextBox Classes="form-field" Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="MyGame" />
                  <TextBlock Text="{Binding Text.ProjectFolderHint}" Classes="muted" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="8" Margin="0,22,0,0">
                  <TextBlock Text="{Binding Text.OutputLocation}" FontSize="14" FontWeight="SemiBold" />
                  <Grid ColumnDefinitions="*,12,92">
                    <TextBox Grid.Column="0" Classes="form-field" Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Classes="form-browse" Content="{Binding Text.Browse}" Click="BrowseProjectOutput_Click" />
                  </Grid>
                  <TextBlock Text="{Binding Text.OutputLocationHint}" Classes="muted" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="8" Margin="0,22,0,0">
                  <TextBlock Text="{Binding Text.ClientType}" FontSize="14" FontWeight="SemiBold" />
                  <ComboBox Classes="form-field" ItemsSource="{Binding ClientOptions}" SelectedItem="{Binding SelectedClient, Mode=TwoWay}" />
                  <TextBlock Text="{Binding Text.ClientTypeHint}" Classes="muted" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="8" Margin="0,22,0,0">
                  <TextBlock Text="{Binding Text.ClientVersion}" FontSize="14" FontWeight="SemiBold" />
                  <ComboBox Classes="form-field" ItemsSource="{Binding ClientVersionOptions}" SelectedItem="{Binding SelectedClientVersion, Mode=TwoWay}" IsEnabled="{Binding HasClientVersion}" />
                  <TextBlock Text="{Binding ClientVersionHint}" Classes="muted" FontSize="12" />
                </StackPanel>
              </StackPanel>

              <Border Grid.Column="1" Width="1" Background="#33332F" HorizontalAlignment="Center" />

              <StackPanel Grid.Column="2" Spacing="0">
                <TextBlock Text="{Binding Text.ProjectConfiguration}" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,18" />

                <Grid ColumnDefinitions="1*,18,1*">
                  <StackPanel Grid.Column="0" Spacing="8">
                    <TextBlock Text="{Binding Text.Transport}" FontSize="14" FontWeight="SemiBold" />
                    <ComboBox Classes="form-field" ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding SelectedTransport, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Text.DefaultKcp}" Classes="muted" FontSize="12" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="8">
                    <TextBlock Text="{Binding Text.Serializer}" FontSize="14" FontWeight="SemiBold" />
                    <ComboBox Classes="form-field" ItemsSource="{Binding SerializerOptions}" SelectedItem="{Binding SelectedSerializer, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Text.DefaultMemoryPack}" Classes="muted" FontSize="12" />
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="8" Margin="0,22,0,0">
                  <TextBlock Text="{Binding Text.Persistence}" FontSize="14" FontWeight="SemiBold" />
                  <ComboBox Classes="form-field" ItemsSource="{Binding PersistenceOptions}" SelectedItem="{Binding SelectedPersistence, Mode=TwoWay}" />
                  <TextBlock Text="{Binding Text.PersistenceHint}" Classes="muted" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="8" Margin="0,22,0,0">
                  <TextBlock Text="{Binding Text.NuGetForUnitySource}" FontSize="14" FontWeight="SemiBold" />
                  <ComboBox Classes="form-field" ItemsSource="{Binding NuGetForUnitySourceOptions}" SelectedItem="{Binding SelectedNuGetForUnitySource, Mode=TwoWay}" IsEnabled="{Binding UsesNuGetForUnity}" />
                  <TextBlock Text="{Binding NuGetForUnityHint}" Classes="muted" FontSize="12" />
                </StackPanel>

                <StackPanel Spacing="8" Margin="0,22,0,0">
                  <TextBlock Text="{Binding Text.DeploymentProfile}" FontSize="14" FontWeight="SemiBold" />
                  <ComboBox Classes="form-field" ItemsSource="{Binding DeploymentProfileOptions}" SelectedItem="{Binding SelectedDeploymentProfile, Mode=TwoWay}" />
                  <TextBlock Text="{Binding Text.DeploymentProfileHint}" Classes="muted" FontSize="12" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <Border BorderBrush="#33332F" BorderThickness="0,1,0,0" Margin="0,38,0,0" Padding="0,24,0,0">
              <Grid ColumnDefinitions="*,18,Auto,12,Auto">
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Text.ProjectWillBeCreatedAt}" Classes="muted" FontSize="12" />
                  <TextBlock Text="{Binding TargetPath}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ValidationMessage}" Classes="gold" FontSize="12" />
                </StackPanel>
                <Button Grid.Column="2" Classes="secondary" Height="56" Content="{Binding Text.Cancel}" Click="CancelCreateProject_Click" />
                <Button Grid.Column="4" Classes="primary" Height="56" Click="ContinueCreateProject_Click" IsEnabled="{Binding CanCreate}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <icons:FluentIcon Icon="FolderAdd" IconVariant="Regular" IconSize="Size24" />
                    <TextBlock Text="{Binding Text.ContinueCreating}" Foreground="#15120A" FontSize="16" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsExperience" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="64,52,56,64" MaxWidth="1080" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Localization.Text.Settings}" FontSize="38" FontWeight="SemiBold" />

            <StackPanel x:Name="SettingsSections" Spacing="24" Margin="0,42,0,0">
              <Border x:Name="DevelopmentEnvironmentCard" Background="#111213" BorderBrush="#34342F" BorderThickness="1" CornerRadius="10" Padding="28">
                <StackPanel Spacing="0">
                  <Grid ColumnDefinitions="48,*,Auto">
                    <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#211F17">
                      <icons:FluentIcon Icon="DeveloperBoard" IconVariant="Regular" IconSize="Size24" Foreground="#EFBE3E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,18,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Localization.Text.DevelopmentEnvironment}" FontSize="22" FontWeight="SemiBold" />
                      <TextBlock Text="{Binding Localization.Text.DevelopmentEnvironmentDescription}" Classes="muted" FontSize="13" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="#211F17" BorderBrush="#6F5923" BorderThickness="1" CornerRadius="12" Padding="12,6" VerticalAlignment="Top">
                      <TextBlock x:Name="EnvironmentStatusText" Classes="gold" FontSize="12" FontWeight="SemiBold" />
                    </Border>
                  </Grid>

                  <Border BorderBrush="#33332F" BorderThickness="0,1,0,0" Margin="0,28,0,0" Padding="0,24,0,0">
                    <Grid ColumnDefinitions="32,*,16,Auto">
                      <icons:FluentIcon Grid.Column="0" Icon="Desktop" IconVariant="Regular" IconSize="Size20" Foreground="#EFBE3E" />
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="{Binding Localization.Text.RuntimeStatus}" Classes="muted" FontSize="12" />
                        <TextBlock x:Name="RuntimeTitleText" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock x:Name="RuntimeVersionText" Classes="gold" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="RuntimeDescriptionText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button x:Name="InstallSdkButton" Grid.Column="3" Classes="secondary" Height="42" Padding="14,7" Click="ShowSdkInstallPrompt_Click" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization.Text.InstallDotNetSdk}" Foreground="{Binding $parent[Button].Foreground}" FontSize="13" />
                      </Button>
                    </Grid>
                  </Border>

                  <Border BorderBrush="#33332F" BorderThickness="0,1,0,0" Margin="0,24,0,0" Padding="0,24,0,0">
                    <StackPanel>
                      <Grid ColumnDefinitions="*,16,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Localization.Text.DetectedTools}" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="secondary" Height="44" Padding="14,7" Click="RefreshEnvironment_Click">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20" />
                            <TextBlock Text="{Binding Localization.Text.RefreshDetection}" Foreground="{Binding $parent[Button].Foreground}" FontSize="13" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>

                      <ItemsControl ItemsSource="{Binding ApplicationTools}" Margin="0,14,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="applications:ApplicationToolItem">
                            <Border BorderBrush="#33332F" BorderThickness="0,1,0,0" Padding="0,13">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding StatusText}" Classes="gold" FontSize="11" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PathText}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip.Tip="{Binding PathText}" />
                                <Button Grid.Column="2" Classes="secondary" Height="38" Padding="12,6" Content="{Binding ActionText}" Click="ApplicationToolAction_Click" VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Button Classes="secondary" Height="44" Margin="0,14,0,0" Click="AddApplicationTool_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <icons:FluentIcon Icon="AddCircle" IconVariant="Regular" IconSize="Size20" />
                          <TextBlock Text="{Binding Localization.Text.AddApplication}" Foreground="{Binding $parent[Button].Foreground}" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>

              <Border x:Name="ApplicationUpdatesCard" Background="#111213" BorderBrush="#34342F" BorderThickness="1" CornerRadius="10" Padding="28">
                <Grid ColumnDefinitions="48,20,*,24,Auto">
                  <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#211F17" VerticalAlignment="Top">
                    <icons:FluentIcon Icon="ArrowDownload" IconVariant="Regular" IconSize="Size24" Foreground="#EFBE3E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization.Text.ApplicationUpdates}" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Localization.Text.ApplicationUpdatesDescription}" Classes="muted" FontSize="13" TextWrapping="Wrap" />
                    <TextBlock x:Name="CurrentHubVersionText" Classes="gold" FontSize="12" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock x:Name="UpdateStatusText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
                    <Grid x:Name="UpdateDownloadProgressPanel" IsVisible="False" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                      <ProgressBar x:Name="UpdateDownloadProgress" Minimum="0" Maximum="100" Height="7" />
                      <TextBlock x:Name="UpdateDownloadProgressText" Grid.Row="1" Classes="muted" FontSize="11" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </Grid>
                  </StackPanel>
                  <Button x:Name="UpdateButton" Grid.Column="4" Classes="primary" Height="48" Padding="18,8" Click="CheckUpdate_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20" Foreground="#15120A" />
                      <TextBlock x:Name="UpdateButtonText" Foreground="#15120A" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>

              <Border x:Name="LanguageSettingsCard" Background="#111213" BorderBrush="#34342F" BorderThickness="1" CornerRadius="10" Padding="28">
                <Grid ColumnDefinitions="48,20,*,24,Auto">
                  <Border Grid.Column="0" Width="48" Height="48" CornerRadius="8" Background="#211F17">
                    <icons:FluentIcon Icon="LocalLanguage" IconVariant="Regular" IconSize="Size24" Foreground="#EFBE3E" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="2" Text="{Binding Localization.Text.LanguageAndRegion}" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <StackPanel Grid.Column="4" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization.Text.DisplayLanguage}" FontSize="13" FontWeight="SemiBold" />
                    <ComboBox Classes="form-field"
                              ItemsSource="{Binding Localization.LanguageOptions}"
                              SelectedItem="{Binding Localization.SelectedLanguage, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Border x:Name="ActionFeedback" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="24" Padding="18,12" CornerRadius="7" Background="#20201B" BorderBrush="#6F5923" BorderThickness="1" MaxWidth="760">
          <TextBlock x:Name="ActionFeedbackText" Classes="muted" FontSize="13" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Grid>

    <Border x:Name="HelpDialogOverlay" Grid.ColumnSpan="2" IsVisible="False" Background="#B8000000">
      <Border MaxWidth="480" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111213" BorderBrush="#4A4944" BorderThickness="1" CornerRadius="12">
        <StackPanel Spacing="0">
          <Border Width="52" Height="52" HorizontalAlignment="Left" Background="#211F17" CornerRadius="9">
            <icons:FluentIcon Icon="QuestionCircle" IconVariant="Regular" IconSize="Size28" Foreground="#EFBE3E" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding Localization.Text.HelpAndFeedback}" FontSize="24" FontWeight="SemiBold" Margin="0,22,0,0" />
          <TextBlock Text="{Binding Localization.Text.HelpDialogDescription}" Classes="muted" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" />
          <Border Background="#0B0C0D" BorderBrush="#34342F" BorderThickness="1" CornerRadius="7" Padding="14,11" Margin="0,18,0,0">
            <TextBlock Text="https://github.com/bruce48x/Lakona/issues" Classes="gold" FontSize="13" TextWrapping="Wrap" />
          </Border>
          <WrapPanel HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Classes="secondary" Height="48" MinWidth="108" Margin="0,0,12,0" Padding="18,8" Content="{Binding Localization.Text.Cancel}" Click="CancelHelp_Click" />
            <Button Classes="primary" Height="48" MinWidth="184" Padding="18,8" Content="{Binding Localization.Text.OpenGitHubIssues}" Click="OpenHelpIssues_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="CrashReportOverlay" Grid.ColumnSpan="2" IsVisible="False" Background="#B8000000">
      <Border MaxWidth="560" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111213" BorderBrush="#4A4944" BorderThickness="1" CornerRadius="12">
        <StackPanel Spacing="0">
          <Border Width="52" Height="52" HorizontalAlignment="Left" Background="#211F17" CornerRadius="9">
            <icons:FluentIcon Icon="Warning" IconVariant="Regular" IconSize="Size28" Foreground="#EFBE3E" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding Localization.Text.PreviousCrashTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,22,0,0" />
          <TextBlock Text="{Binding Localization.Text.PreviousCrashDescription}" Classes="muted" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" />
          <Border Background="#0B0C0D" BorderBrush="#34342F" BorderThickness="1" CornerRadius="7" Padding="14,11" Margin="0,18,0,0">
            <TextBlock x:Name="CrashReportSummaryText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </Border>
          <TextBlock Text="{Binding Localization.Text.CrashPrivacyNotice}" Classes="muted" FontSize="12" TextWrapping="Wrap" Margin="0,12,0,0" />
          <WrapPanel HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button Classes="secondary" Height="48" MinWidth="108" Margin="0,0,12,0" Padding="18,8" Content="{Binding Localization.Text.IgnoreCrashReport}" Click="DismissCrashReport_Click" />
            <Button Classes="primary" Height="48" MinWidth="184" Padding="18,8" Content="{Binding Localization.Text.SendCrashFeedback}" Click="SendCrashReport_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="SdkInstallOverlay" Grid.ColumnSpan="2" IsVisible="False" Background="#B8000000">
      <Border MaxWidth="540" Padding="30" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#111213" BorderBrush="#4A4944" BorderThickness="1" CornerRadius="12">
        <StackPanel Spacing="0">
          <Border Width="52" Height="52" HorizontalAlignment="Left" Background="#211F17" CornerRadius="9">
            <icons:FluentIcon Icon="ArrowDownload" IconVariant="Regular" IconSize="Size28" Foreground="#EFBE3E" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding Localization.Text.DotNetSdkRequiredTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,22,0,0" />
          <TextBlock Text="{Binding Localization.Text.DotNetSdkRequiredDescription}" Classes="muted" FontSize="14" TextWrapping="Wrap" Margin="0,10,0,0" />
          <Border Background="#0B0C0D" BorderBrush="#34342F" BorderThickness="1" CornerRadius="7" Padding="14,11" Margin="0,18,0,0">
            <StackPanel Spacing="5">
              <TextBlock Text="{Binding Localization.Text.DotNetSdkDownloadSource}" Classes="gold" FontSize="12" />
              <TextBlock Text="{Binding Localization.Text.DotNetSdkInstallLocation}" Classes="muted" FontSize="12" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel x:Name="SdkInstallProgressPanel" IsVisible="False" Margin="0,20,0,0" Spacing="6">
            <ProgressBar x:Name="SdkInstallProgress" Minimum="0" Maximum="100" Height="8" />
            <TextBlock x:Name="SdkInstallProgressText" Classes="muted" FontSize="12" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock x:Name="SdkInstallErrorText" IsVisible="False" Foreground="#E87777" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0" />
          <WrapPanel HorizontalAlignment="Right" Margin="0,26,0,0">
            <Button x:Name="CancelSdkInstallButton" Classes="secondary" Height="48" MinWidth="108" Margin="0,0,12,0" Padding="18,8" Content="{Binding Localization.Text.Cancel}" Click="CancelSdkInstall_Click" />
            <Button x:Name="ConfirmSdkInstallButton" Classes="primary" Height="48" MinWidth="184" Padding="18,8" Content="{Binding Localization.Text.DownloadAndInstallSdk}" Click="InstallSdk_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.ColumnSpan="2" Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" Tag="West" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" Tag="East" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Height="6" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" Tag="North" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Height="6" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" Tag="South" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="ResizeGrip_PointerPressed" />
  </Grid>
  </Border>
</Window>
