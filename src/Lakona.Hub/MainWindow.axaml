<Window
    x:Class="Lakona.Hub.MainWindow"
    x:DataType="local:MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:applications="using:Lakona.Hub.Applications"
    xmlns:icons="using:FluentIcons.Avalonia"
    xmlns:local="using:Lakona.Hub"
    Title="Lakona Hub"
    Icon="/Assets/lakona-hub-2048.png"
    Width="1440"
    Height="1024"
    MinWidth="1000"
    MinHeight="800"
    CanResize="True"
    Background="Transparent"
    FontFamily="Microsoft YaHei UI"
    TransparencyLevelHint="Transparent"
    WindowDecorations="None"
    WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TextBlock">
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextPrimary}" />
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Body}" />
    </Style>
    <Style Selector="TextBlock.muted">
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextMuted}" />
    </Style>
    <Style Selector="TextBlock.gold">
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.Accent}" />
    </Style>
    <Style Selector="TextBlock.metadata">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Metadata}" />
    </Style>
    <Style Selector="TextBlock.caption">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Caption}" />
    </Style>
    <Style Selector="TextBlock.control-label">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Control}" />
    </Style>
    <Style Selector="TextBlock.status">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Status}" />
    </Style>
    <Style Selector="TextBlock.navigation-label">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Navigation}" />
    </Style>
    <Style Selector="TextBlock.action-label">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Action}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.hero-action-label">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.HeroAction}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.section-title">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.SectionTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.card-title">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.CardTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.dialog-title">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.DialogTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.page-title">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.PageTitle}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.form-label">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="TextBlock.form-hint">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Caption}" />
    </Style>
    <Style Selector="TextBlock.card-description">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Control}" />
    </Style>
    <Style Selector="TextBlock.dialog-body">
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Body}" />
    </Style>
    <Style Selector="Button">
      <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button > StackPanel">
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Button TextBlock">
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="TextAlignment" Value="Center" />
    </Style>
    <Style Selector="Button.primary">
      <Setter Property="Background" Value="{DynamicResource HubBrush.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextOnAccent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Control}" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="{DynamicResource HubInset.Action}" />
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Action}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.primary.hero">
      <Setter Property="Height" Value="74" />
      <Setter Property="MinWidth" Value="242" />
      <Setter Property="FontSize" Value="{DynamicResource HubFont.HeroAction}" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.AccentHover}" />
    </Style>
    <Style Selector="Button.secondary">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Control}" />
      <Setter Property="Height" Value="64" />
      <Setter Property="Padding" Value="{DynamicResource HubInset.SecondaryAction}" />
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Action}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.secondary.hero">
      <Setter Property="Height" Value="74" />
      <Setter Property="MinWidth" Value="258" />
      <Setter Property="FontSize" Value="{DynamicResource HubFont.HeroAction}" />
    </Style>
    <Style Selector="Button.secondary:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceRaised}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.Accent}" />
    </Style>
    <Style Selector="Button.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextMuted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Control}" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="Padding" Value="20,15" />
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Navigation}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceHover}" />
    </Style>
    <Style Selector="Button.nav.selected">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceSelected}" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.Accent}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.Accent}" />
      <Setter Property="BorderThickness" Value="4,0,0,0" />
    </Style>
    <Style Selector="Button.server-open">
      <Setter Property="Width" Value="58" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="8,10" />
      <Setter Property="Background" Value="{DynamicResource HubBrush.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextOnAccent}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Small}" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.server-open:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.AccentHover}" />
    </Style>
    <Style Selector="Button.client-open">
      <Setter Property="MinWidth" Value="142" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="13,9" />
      <Setter Property="Background" Value="{DynamicResource HubBrush.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Small}" />
    </Style>
    <Style Selector="Button.client-open:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderAccent}" />
    </Style>
    <Style Selector="Button:disabled">
      <Setter Property="Opacity" Value="0.42" />
    </Style>
    <Style Selector="ComboBox.server-editor">
      <Setter Property="MinWidth" Value="168" />
      <Setter Property="Height" Value="48" />
      <Setter Property="Padding" Value="10,6" />
      <Setter Property="Background" Value="{DynamicResource HubBrush.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderAccent}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Small}" />
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Body}" />
    </Style>
    <Style Selector="ComboBox.server-editor:pointerover /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.Accent}" />
    </Style>
    <Style Selector="TextBox.form-field">
      <Setter Property="Height" Value="52" />
      <Setter Property="Padding" Value="{DynamicResource HubInset.Field}" />
      <Setter Property="Background" Value="{DynamicResource HubBrush.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Control}" />
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Status}" />
    </Style>
    <Style Selector="TextBox.form-field:focus /template/ Border#PART_BorderElement">
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.Accent}" />
    </Style>
    <Style Selector="ComboBox.form-field">
      <Setter Property="Height" Value="52" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="12,8" />
      <Setter Property="Background" Value="{DynamicResource HubBrush.Surface}" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextPrimary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Control}" />
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Status}" />
    </Style>
    <Style Selector="ComboBox.form-field:pointerover /template/ Border#Background">
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.Accent}" />
    </Style>
    <Style Selector="Button.form-browse">
      <Setter Property="Width" Value="92" />
      <Setter Property="Height" Value="52" />
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceRaised}" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.Accent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderAccentMuted}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Control}" />
      <Setter Property="FontSize" Value="{DynamicResource HubFont.Body}" />
    </Style>
    <Style Selector="Button.form-browse:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceAccentMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.Accent}" />
    </Style>
    <Style Selector="Button.back">
      <Setter Property="Width" Value="44" />
      <Setter Property="Height" Value="44" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextSecondary}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Control}" />
    </Style>
    <Style Selector="Button.back:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceHover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.Accent}" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.Accent}" />
    </Style>
    <Style Selector="ListBox.project-list">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.project-list ListBoxItem">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="ListBox.project-list ListBoxItem:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceListHover}" />
    </Style>
    <Style Selector="ListBox.project-list ListBoxItem:selected /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceSelected}" />
    </Style>
    <Style Selector="Button.window-control">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextMuted}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="CornerRadius" Value="0" />
      <Setter Property="Width" Value="48" />
      <Setter Property="Height" Value="40" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.window-control:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceHover}" />
    </Style>
    <Style Selector="Button.window-control.close:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.Danger}" />
      <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.project-more">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource HubBrush.TextMuted}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Control}" />
      <Setter Property="Width" Value="42" />
      <Setter Property="Height" Value="42" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <Style Selector="Button.project-more:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceHover}" />
    </Style>
    <Style Selector="Border.window-frame">
      <Setter Property="CornerRadius" Value="14" />
    </Style>
    <Style Selector="Border.window-frame.maximized">
      <Setter Property="CornerRadius" Value="0" />
    </Style>
    <Style Selector="Border.settings-card">
      <Setter Property="Background" Value="{DynamicResource HubBrush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderCard}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Card}" />
      <Setter Property="Padding" Value="{DynamicResource HubInset.Card}" />
    </Style>
    <Style Selector="Border.settings-card-icon">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceAccentMuted}" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Icon}" />
    </Style>
    <Style Selector="Border.dialog-icon">
      <Setter Property="Background" Value="{DynamicResource HubBrush.SurfaceAccentMuted}" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Icon}" />
    </Style>
    <Style Selector="Border.dialog-surface">
      <Setter Property="Background" Value="{DynamicResource HubBrush.Surface}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderDefault}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Dialog}" />
      <Setter Property="Padding" Value="{DynamicResource HubInset.Dialog}" />
    </Style>
    <Style Selector="Border.dialog-detail">
      <Setter Property="Background" Value="{DynamicResource HubBrush.Window}" />
      <Setter Property="BorderBrush" Value="{DynamicResource HubBrush.BorderCard}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="{DynamicResource HubRadius.Control}" />
      <Setter Property="Padding" Value="{DynamicResource HubInset.DialogDetail}" />
      <Setter Property="Margin" Value="{DynamicResource HubInset.DialogActions}" />
    </Style>
    <Style Selector="WrapPanel.dialog-actions">
      <Setter Property="HorizontalAlignment" Value="Right" />
      <Setter Property="Margin" Value="{DynamicResource HubInset.DialogActions}" />
    </Style>
  </Window.Styles>

  <Border x:Name="WindowFrame" Classes="window-frame" Background="{DynamicResource HubBrush.Window}" ClipToBounds="True">
  <Grid ColumnDefinitions="220,*">
    <Border Grid.Column="0" Background="{DynamicResource HubBrush.Sidebar}" BorderBrush="{DynamicResource HubBrush.BorderSidebar}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="160,Auto,*,Auto" Margin="10,18,10,20">
        <StackPanel Grid.Row="0" Spacing="8" HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="  /\_/\&#10; ( oᴥo )&#10;  U___U"
                     FontFamily="monospace"
                     FontSize="{DynamicResource HubFont.Action}"
                     LineHeight="20"
                     HorizontalAlignment="Center"
                     TextAlignment="Center" />
          <TextBlock Text="Lakona Hub"
                     FontSize="{DynamicResource HubFont.CardTitle}"
                     FontWeight="SemiBold"
                     HorizontalAlignment="Center"
                     TextAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="1" Spacing="12">
          <Button x:Name="ProjectsNavButton" Classes="nav selected" Click="Projects_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <icons:FluentIcon Icon="Folder" IconVariant="Regular" IconSize="Size24" />
              <TextBlock Text="{Binding Localization.Text.Projects}" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
          <Button x:Name="SettingsNavButton" Classes="nav" Click="Settings_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <icons:FluentIcon Icon="Settings" IconVariant="Regular" IconSize="Size24" />
              <TextBlock Text="{Binding Localization.Text.Settings}" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </StackPanel>

        <Border Grid.Row="3" BorderBrush="{DynamicResource HubBrush.BorderSidebar}" BorderThickness="0,1,0,0" Padding="4,24,4,0">
          <Button Classes="nav" Click="Help_Click">
            <StackPanel Orientation="Horizontal" Spacing="14">
              <icons:FluentIcon Icon="QuestionCircle" IconVariant="Regular" IconSize="Size24" />
              <TextBlock Text="{Binding Localization.Text.HelpAndFeedback}" Foreground="{Binding $parent[Button].Foreground}" VerticalAlignment="Center" />
            </StackPanel>
          </Button>
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="52,*" Background="{DynamicResource HubBrush.Window}">
      <Border Grid.Row="0" Background="{DynamicResource HubBrush.Window}" PointerPressed="TitleBar_PointerPressed">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Classes="window-control" Click="Minimize_Click" ToolTip.Tip="{Binding Localization.Text.Minimize}">
            <icons:FluentIcon Icon="Subtract" IconVariant="Regular" IconSize="Size16" />
          </Button>
          <Button Classes="window-control" Click="Maximize_Click" ToolTip.Tip="{Binding Localization.Text.Maximize}">
            <icons:FluentIcon Icon="Square" IconVariant="Regular" IconSize="Size16" />
          </Button>
          <Button Classes="window-control close" Click="Close_Click" ToolTip.Tip="{Binding Localization.Text.Close}">
            <icons:FluentIcon Icon="Dismiss" IconVariant="Regular" IconSize="Size20" />
          </Button>
        </StackPanel>
      </Border>

      <Grid Grid.Row="1">
        <Grid x:Name="EmptyExperience">
          <StackPanel x:Name="EmptyProjectContent" Spacing="28" HorizontalAlignment="Center" VerticalAlignment="Center">
            <WrapPanel x:Name="EmptyProjectActions" HorizontalAlignment="Center">
              <Button Classes="primary hero" Margin="6" Click="CreateProject_Click">
                <StackPanel Orientation="Horizontal" Spacing="13">
                  <icons:FluentIcon Icon="FolderAdd" IconVariant="Regular" IconSize="Size28" />
                  <TextBlock Text="{Binding Localization.Text.CreateProject}" Foreground="{Binding $parent[Button].Foreground}" Classes="hero-action-label" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="secondary hero" Margin="6" Click="ImportProject_Click">
                <StackPanel Orientation="Horizontal" Spacing="13">
                  <icons:FluentIcon Icon="FolderArrowRight" IconVariant="Regular" IconSize="Size28" />
                  <TextBlock Text="{Binding Localization.Text.ImportExistingProject}" Foreground="{Binding $parent[Button].Foreground}" Classes="hero-action-label" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <WrapPanel HorizontalAlignment="Center">
              <icons:FluentIcon Icon="CheckmarkCircle" IconVariant="Regular" IconSize="Size24" Foreground="{DynamicResource HubBrush.Accent}" />
              <TextBlock Text="{Binding StatusSummary.SdkStatusText}" Classes="status" VerticalAlignment="Center" Margin="15,0,0,0" />
              <Border Width="1" Height="22" Background="{DynamicResource HubBrush.BorderDefault}" Margin="8,0" />
              <TextBlock Text="{Binding StatusSummary.EnvironmentSummaryText}" Classes="muted" VerticalAlignment="Center" />
            </WrapPanel>
          </StackPanel>
        </Grid>

        <ScrollViewer x:Name="ProjectExperience" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="48,34,32,32">
            <WrapPanel HorizontalAlignment="Left" VerticalAlignment="Center">
              <TextBlock Text="{Binding Localization.Text.MyProjects}" Classes="page-title" VerticalAlignment="Center" Margin="0,0,18,8" />
              <Button Classes="primary" Margin="0,0,12,8" Click="CreateProject_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <icons:FluentIcon Icon="FolderAdd" IconVariant="Regular" IconSize="Size24" />
                  <TextBlock Text="{Binding Localization.Text.CreateProject}" Foreground="{Binding $parent[Button].Foreground}" Classes="action-label" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
              <Button Classes="secondary" Margin="0,0,12,8" Click="ImportProject_Click">
                <StackPanel Orientation="Horizontal" Spacing="12">
                  <icons:FluentIcon Icon="FolderArrowRight" IconVariant="Regular" IconSize="Size24" />
                  <TextBlock Text="{Binding Localization.Text.ImportExistingProject}" Foreground="{Binding $parent[Button].Foreground}" Classes="action-label" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </WrapPanel>

            <WrapPanel Margin="0,16,0,0">
              <icons:FluentIcon Icon="CheckmarkCircle" IconVariant="Regular" IconSize="Size24" Foreground="{DynamicResource HubBrush.Accent}" />
              <TextBlock Text="{Binding StatusSummary.SdkStatusText}" Classes="muted" VerticalAlignment="Center" Margin="15,0,0,0" />
              <Border Width="1" Height="22" Background="{DynamicResource HubBrush.BorderDefault}" Margin="8,0" />
              <TextBlock Text="{Binding StatusSummary.EnvironmentSummaryText}" Classes="muted" VerticalAlignment="Center" />
            </WrapPanel>

            <StackPanel Margin="0,36,0,0" Spacing="0">
              <Grid ColumnDefinitions="1.45*,0.9*,1.0*,0.8*,1.65*,1.15*,44" Margin="0,0,0,14">
                <TextBlock Grid.Column="0" Text="{Binding Localization.Text.ProjectName}" Classes="muted" />
                <TextBlock Grid.Column="1" Text="{Binding Localization.Text.EngineVersion}" Classes="muted" />
                <TextBlock Grid.Column="2" Text="{Binding Localization.Text.LakonaVersion}" Classes="muted" />
                <TextBlock Grid.Column="3" Text="{Binding Localization.Text.LastOpened}" Classes="muted" />
                <TextBlock Grid.Column="4" Text="{Binding Localization.Text.OpenServer}" Classes="muted" HorizontalAlignment="Center" />
                <TextBlock Grid.Column="5" Text="{Binding Localization.Text.OpenClient}" Classes="muted" HorizontalAlignment="Center" />
              </Grid>

              <Border BorderBrush="{DynamicResource HubBrush.BorderSubtle}" BorderThickness="0,1,0,0">
                <ListBox x:Name="ProjectList" Classes="project-list" ItemsSource="{Binding Projects}" SelectionChanged="ProjectList_SelectionChanged">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="local:ProjectListItem">
                      <Border BorderBrush="{DynamicResource HubBrush.BorderSubtle}" BorderThickness="0,0,0,1" MinHeight="80" Padding="0,14">
                        <Grid ColumnDefinitions="1.45*,0.9*,1.0*,0.8*,1.65*,1.15*,44">
                          <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="16" VerticalAlignment="Center">
                            <icons:FluentIcon Icon="Cube" IconVariant="Regular" IconSize="Size24" Foreground="{DynamicResource HubBrush.Accent}" />
                            <TextBlock Text="{Binding Name}" FontSize="{DynamicResource HubFont.Navigation}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </StackPanel>
                          <TextBlock Grid.Column="1" Text="{Binding Client}" Classes="muted status" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="2" Text="{Binding LakonaVersion}" Classes="muted status" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="3" Text="{Binding LastOpened}" Classes="muted status" VerticalAlignment="Center" />

                          <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ComboBox Classes="server-editor" ItemsSource="{Binding ServerEditors}" SelectedItem="{Binding SelectedServerEditor, Mode=TwoWay}" IsEnabled="{Binding CanOpenServer}" ToolTip.Tip="{Binding ServerOpenToolTip}">
                              <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="applications:LocalApplicationInstallation">
                                  <StackPanel Orientation="Horizontal" Spacing="9">
                                    <icons:FluentIcon Icon="Code" IconVariant="Regular" IconSize="Size20" Foreground="{DynamicResource HubBrush.Accent}" />
                                    <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                  </StackPanel>
                                </DataTemplate>
                              </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Button Classes="server-open" Content="{Binding OpenText}" Click="OpenServer_Click" IsEnabled="{Binding CanOpenServer}" ToolTip.Tip="{Binding ServerOpenToolTip}" />
                          </StackPanel>

                          <Button Grid.Column="5" Classes="client-open" Click="OpenClient_Click" IsEnabled="{Binding CanOpenClient}" ToolTip.Tip="{Binding ClientOpenToolTip}" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" Spacing="9">
                              <icons:FluentIcon Icon="WindowDevEdit" IconVariant="Regular" IconSize="Size20" />
                              <TextBlock Text="{Binding ClientActionText}" Foreground="{Binding $parent[Button].Foreground}" />
                            </StackPanel>
                          </Button>

                          <Button Grid.Column="6" Classes="project-more" ToolTip.Tip="{Binding MoreActionsText}" Click="ProjectMore_Click" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <icons:FluentIcon Icon="MoreHorizontal" IconVariant="Regular" IconSize="Size20" />
                            <Button.ContextMenu>
                              <ContextMenu>
                                <MenuItem Header="{Binding ServerActionText}" Click="OpenServer_Click" IsEnabled="{Binding CanOpenServer}" />
                                <MenuItem Header="{Binding ClientActionText}" Click="OpenClient_Click" IsEnabled="{Binding CanOpenClient}" />
                                <Separator />
                                <MenuItem Header="{Binding RemoveFromListText}" Click="RemoveProjectFromList_Click" />
                              </ContextMenu>
                            </Button.ContextMenu>
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="CreateExperience" IsVisible="False" HorizontalScrollBarVisibility="Disabled" DataContext="{Binding CreationForm}">
          <StackPanel x:DataType="local:ProjectCreationForm" Margin="48,30,36,36" MaxWidth="1120" HorizontalAlignment="Stretch">
            <StackPanel Orientation="Horizontal" Spacing="18">
              <Button Classes="back" Click="CancelCreateProject_Click" ToolTip.Tip="{Binding Text.BackToProjects}">
                <icons:FluentIcon Icon="ArrowLeft" IconVariant="Regular" IconSize="Size24" />
              </Button>
              <StackPanel Spacing="5" VerticalAlignment="Center">
                <TextBlock Text="{Binding Text.CreateProject}" Classes="page-title" />
                <TextBlock Text="{Binding Text.CreateDescription}" Classes="muted status" />
              </StackPanel>
            </StackPanel>

            <Grid ColumnDefinitions="1*,32,1*" Margin="0,28,0,0">
              <StackPanel Grid.Column="0" Spacing="0">
                <TextBlock Text="{Binding Text.BasicInformation}" Classes="section-title" Margin="0,0,0,12" />

                <StackPanel Spacing="8">
                  <TextBlock Text="{Binding Text.ProjectName}" Classes="form-label" />
                  <TextBox Classes="form-field" Text="{Binding ProjectName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" PlaceholderText="MyGame" />
                  <TextBlock Text="{Binding Text.ProjectFolderHint}" Classes="muted form-hint" />
                </StackPanel>

                <StackPanel Spacing="6" Margin="0,16,0,0">
                  <TextBlock Text="{Binding Text.OutputLocation}" Classes="form-label" />
                  <Grid ColumnDefinitions="*,12,92">
                    <TextBox Grid.Column="0" Classes="form-field" Text="{Binding OutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Grid.Column="2" Classes="form-browse" Content="{Binding Text.Browse}" Click="BrowseProjectOutput_Click" />
                  </Grid>
                  <TextBlock Text="{Binding Text.OutputLocationHint}" Classes="muted form-hint" />
                </StackPanel>

                <StackPanel Spacing="6" Margin="0,16,0,0">
                  <TextBlock Text="{Binding Text.ClientType}" Classes="form-label" />
                  <ComboBox Classes="form-field" ItemsSource="{Binding ClientOptions}" SelectedItem="{Binding SelectedClient, Mode=TwoWay}" />
                  <TextBlock Text="{Binding Text.ClientTypeHint}" Classes="muted form-hint" />
                </StackPanel>

                <StackPanel Spacing="6" Margin="0,16,0,0">
                  <TextBlock Text="{Binding Text.ClientVersion}" Classes="form-label" />
                  <ComboBox Classes="form-field" ItemsSource="{Binding ClientVersionOptions}" SelectedItem="{Binding SelectedClientVersion, Mode=TwoWay}" IsEnabled="{Binding HasClientVersion}" />
                  <TextBlock Text="{Binding ClientVersionHint}" Classes="muted form-hint" />
                </StackPanel>
              </StackPanel>

              <Border Grid.Column="1" Width="1" Background="{DynamicResource HubBrush.BorderSubtle}" HorizontalAlignment="Center" />

              <StackPanel Grid.Column="2" Spacing="0">
                <TextBlock Text="{Binding Text.ProjectConfiguration}" Classes="section-title" Margin="0,0,0,12" />

                <Grid ColumnDefinitions="1*,14,1*">
                  <StackPanel Grid.Column="0" Spacing="6">
                    <TextBlock Text="{Binding Text.Transport}" Classes="form-label" />
                    <ComboBox Classes="form-field" ItemsSource="{Binding TransportOptions}" SelectedItem="{Binding SelectedTransport, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Text.DefaultKcp}" Classes="muted form-hint" />
                  </StackPanel>
                  <StackPanel Grid.Column="2" Spacing="6">
                    <TextBlock Text="{Binding Text.Serializer}" Classes="form-label" />
                    <ComboBox Classes="form-field" ItemsSource="{Binding SerializerOptions}" SelectedItem="{Binding SelectedSerializer, Mode=TwoWay}" />
                    <TextBlock Text="{Binding Text.DefaultMemoryPack}" Classes="muted form-hint" />
                  </StackPanel>
                </Grid>

                <StackPanel Spacing="6" Margin="0,16,0,0">
                  <TextBlock Text="{Binding Text.Persistence}" Classes="form-label" />
                  <ComboBox Classes="form-field" ItemsSource="{Binding PersistenceOptions}" SelectedItem="{Binding SelectedPersistence, Mode=TwoWay}" />
                  <TextBlock Text="{Binding Text.PersistenceHint}" Classes="muted form-hint" />
                </StackPanel>

                <StackPanel Spacing="6" Margin="0,16,0,0">
                  <TextBlock Text="{Binding Text.NuGetForUnitySource}" Classes="form-label" />
                  <ComboBox Classes="form-field" ItemsSource="{Binding NuGetForUnitySourceOptions}" SelectedItem="{Binding SelectedNuGetForUnitySource, Mode=TwoWay}" IsEnabled="{Binding UsesNuGetForUnity}" />
                  <TextBlock Text="{Binding NuGetForUnityHint}" Classes="muted form-hint" />
                </StackPanel>

                <StackPanel Spacing="6" Margin="0,16,0,0">
                  <TextBlock Text="{Binding Text.DeploymentProfile}" Classes="form-label" />
                  <ComboBox Classes="form-field" ItemsSource="{Binding DeploymentProfileOptions}" SelectedItem="{Binding SelectedDeploymentProfile, Mode=TwoWay}" />
                  <TextBlock Text="{Binding Text.DeploymentProfileHint}" Classes="muted form-hint" />
                </StackPanel>
              </StackPanel>
            </Grid>

            <Border BorderBrush="{DynamicResource HubBrush.BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,26,0,0" Padding="0,18,0,0">
              <Grid ColumnDefinitions="*,18,Auto,12,Auto">
                <StackPanel Grid.Column="0" Spacing="6" VerticalAlignment="Center">
                  <TextBlock Text="{Binding Text.ProjectWillBeCreatedAt}" Classes="muted form-hint" />
                  <TextBlock Text="{Binding TargetPath}" Classes="form-label" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding ValidationMessage}" Classes="gold form-hint" />
                </StackPanel>
                <Button Grid.Column="2" Classes="secondary" Height="56" Content="{Binding Text.Cancel}" Click="CancelCreateProject_Click" />
                <Button Grid.Column="4" Classes="primary" Height="56" Click="ContinueCreateProject_Click" IsEnabled="{Binding CanCreate}">
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <icons:FluentIcon Icon="FolderAdd" IconVariant="Regular" IconSize="Size24" />
                    <TextBlock Text="{Binding Text.ContinueCreating}" Foreground="{Binding $parent[Button].Foreground}" Classes="navigation-label" FontWeight="SemiBold" />
                  </StackPanel>
                </Button>
              </Grid>
            </Border>
          </StackPanel>
        </ScrollViewer>

        <ScrollViewer x:Name="SettingsExperience" IsVisible="False" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="48,34,40,36" MaxWidth="1080" HorizontalAlignment="Stretch">
            <TextBlock Text="{Binding Localization.Text.Settings}" Classes="page-title" />

            <StackPanel x:Name="SettingsSections" Spacing="16" Margin="0,28,0,0">
              <Border x:Name="ApplicationUpdatesCard" Classes="settings-card">
                <Grid ColumnDefinitions="48,20,*,24,Auto">
                  <Border Grid.Column="0" Classes="settings-card-icon" Width="48" Height="48" VerticalAlignment="Top">
                    <icons:FluentIcon Icon="ArrowDownload" IconVariant="Regular" IconSize="Size24" Foreground="{DynamicResource HubBrush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <StackPanel Grid.Column="2" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization.Text.ApplicationUpdates}" Classes="card-title" />
                    <TextBlock Text="{Binding Localization.Text.ApplicationUpdatesDescription}" Classes="muted card-description" TextWrapping="Wrap" />
                    <TextBlock x:Name="CurrentHubVersionText" Classes="gold caption" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <TextBlock x:Name="UpdateStatusText" Classes="muted caption" TextWrapping="Wrap" />
                    <Grid x:Name="UpdateDownloadProgressPanel" IsVisible="False" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                      <ProgressBar x:Name="UpdateDownloadProgress" Minimum="0" Maximum="100" Height="7" />
                      <TextBlock x:Name="UpdateDownloadProgressText" Grid.Row="1" Classes="muted metadata" HorizontalAlignment="Right" Margin="0,4,0,0" />
                    </Grid>
                  </StackPanel>
                  <Button x:Name="UpdateButton" Grid.Column="4" Classes="primary" Height="48" Padding="18,8" Click="CheckUpdate_Click" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <icons:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20" Foreground="{Binding $parent[Button].Foreground}" />
                      <TextBlock x:Name="UpdateButtonText" Foreground="{Binding $parent[Button].Foreground}" Classes="control-label" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>
                </Grid>
              </Border>

              <Border x:Name="LanguageSettingsCard" Classes="settings-card">
                <Grid ColumnDefinitions="48,20,*,24,Auto">
                  <Border Grid.Column="0" Classes="settings-card-icon" Width="48" Height="48">
                    <icons:FluentIcon Icon="LocalLanguage" IconVariant="Regular" IconSize="Size24" Foreground="{DynamicResource HubBrush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                  </Border>
                  <TextBlock Grid.Column="2" Text="{Binding Localization.Text.LanguageAndRegion}" Classes="card-title" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <StackPanel Grid.Column="4" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Localization.Text.DisplayLanguage}" Classes="control-label" FontWeight="SemiBold" />
                    <ComboBox Classes="form-field"
                              ItemsSource="{Binding Localization.LanguageOptions}"
                              SelectedItem="{Binding Localization.SelectedLanguage, Mode=TwoWay}" />
                  </StackPanel>
                </Grid>
              </Border>

              <Border x:Name="DevelopmentEnvironmentCard" Classes="settings-card">
                <StackPanel Spacing="0">
                  <Grid ColumnDefinitions="48,*,Auto">
                    <Border Grid.Column="0" Classes="settings-card-icon" Width="48" Height="48">
                      <icons:FluentIcon Icon="DeveloperBoard" IconVariant="Regular" IconSize="Size24" Foreground="{DynamicResource HubBrush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Grid.Column="1" Margin="16,0,18,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Localization.Text.DevelopmentEnvironment}" Classes="card-title" />
                      <TextBlock Text="{Binding Localization.Text.DevelopmentEnvironmentDescription}" Classes="muted card-description" TextWrapping="Wrap" Margin="0,5,0,0" />
                    </StackPanel>
                    <Border Grid.Column="2" Background="{DynamicResource HubBrush.SurfaceAccentMuted}" BorderBrush="{DynamicResource HubBrush.BorderAccentMuted}" BorderThickness="1" CornerRadius="{DynamicResource HubRadius.Dialog}" Padding="12,6" VerticalAlignment="Top">
                      <TextBlock x:Name="EnvironmentStatusText" Classes="gold caption" FontWeight="SemiBold" />
                    </Border>
                  </Grid>

                  <Border BorderBrush="{DynamicResource HubBrush.BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,20,0,0" Padding="0,18,0,0">
                    <Grid ColumnDefinitions="32,*,16,Auto">
                      <icons:FluentIcon Grid.Column="0" Icon="Desktop" IconVariant="Regular" IconSize="Size20" Foreground="{DynamicResource HubBrush.Accent}" />
                      <StackPanel Grid.Column="1" Spacing="5">
                        <TextBlock Text="{Binding Localization.Text.RuntimeStatus}" Classes="muted caption" />
                        <TextBlock x:Name="RuntimeTitleText" Classes="status" FontWeight="SemiBold" />
                        <TextBlock x:Name="RuntimeVersionText" Classes="gold caption" FontWeight="SemiBold" />
                        <TextBlock x:Name="RuntimeDescriptionText" Classes="muted caption" TextWrapping="Wrap" />
                      </StackPanel>
                      <Button x:Name="InstallSdkButton" Grid.Column="3" Classes="secondary" Height="42" Padding="14,7" Click="ShowSdkInstallPrompt_Click" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Localization.Text.InstallDotNetSdk}" Foreground="{Binding $parent[Button].Foreground}" Classes="control-label" />
                      </Button>
                    </Grid>
                  </Border>

                  <Border BorderBrush="{DynamicResource HubBrush.BorderSubtle}" BorderThickness="0,1,0,0" Margin="0,18,0,0">
                    <StackPanel>
                      <Grid ColumnDefinitions="*,16,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Localization.Text.DetectedTools}" Classes="navigation-label" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button Grid.Column="2" Classes="secondary" Height="44" Padding="14,7" Click="RefreshEnvironment_Click">
                          <StackPanel Orientation="Horizontal" Spacing="8">
                            <icons:FluentIcon Icon="ArrowSync" IconVariant="Regular" IconSize="Size20" />
                            <TextBlock Text="{Binding Localization.Text.RefreshDetection}" Foreground="{Binding $parent[Button].Foreground}" Classes="control-label" VerticalAlignment="Center" />
                          </StackPanel>
                        </Button>
                      </Grid>

                      <ItemsControl ItemsSource="{Binding ApplicationTools}" Margin="0,10,0,0">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="applications:ApplicationToolItem">
                            <Border BorderBrush="{DynamicResource HubBrush.BorderSubtle}" BorderThickness="0,1,0,0" Padding="0,10">
                              <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Grid.Column="0" Spacing="3" VerticalAlignment="Center">
                                  <TextBlock Text="{Binding DisplayName}" Classes="control-label" FontWeight="SemiBold" />
                                  <TextBlock Text="{Binding StatusText}" Classes="gold metadata" />
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding PathText}" Classes="muted metadata" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" ToolTip.Tip="{Binding PathText}" />
                                <Button Grid.Column="2" Classes="secondary" Height="38" Padding="12,6" Content="{Binding ActionText}" Click="ApplicationToolAction_Click" VerticalAlignment="Center" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>

                      <Button Classes="secondary" Height="44" Margin="0,10,0,0" Click="AddApplicationTool_Click" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <icons:FluentIcon Icon="AddCircle" IconVariant="Regular" IconSize="Size20" />
                          <TextBlock Text="{Binding Localization.Text.AddApplication}" Foreground="{Binding $parent[Button].Foreground}" Classes="control-label" VerticalAlignment="Center" />
                        </StackPanel>
                      </Button>
                    </StackPanel>
                  </Border>
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>

        <Border x:Name="ActionFeedback" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="18" Padding="14,10" CornerRadius="{DynamicResource HubRadius.Control}" Background="{DynamicResource HubBrush.SurfaceFeedback}" BorderBrush="{DynamicResource HubBrush.BorderAccentMuted}" BorderThickness="1" MaxWidth="760">
          <TextBlock x:Name="ActionFeedbackText" Classes="muted control-label" TextWrapping="Wrap" />
        </Border>
      </Grid>
    </Grid>

    <Border x:Name="HelpDialogOverlay" Grid.ColumnSpan="2" IsVisible="False" Background="{DynamicResource HubBrush.Overlay}">
      <Border Classes="dialog-surface" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="0">
          <Border Classes="dialog-icon" Width="52" Height="52" HorizontalAlignment="Left">
            <icons:FluentIcon Icon="QuestionCircle" IconVariant="Regular" IconSize="Size28" Foreground="{DynamicResource HubBrush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding Localization.Text.HelpAndFeedback}" Classes="dialog-title" Margin="0,16,0,0" />
          <TextBlock Text="{Binding Localization.Text.HelpDialogDescription}" Classes="muted dialog-body" TextWrapping="Wrap" Margin="0,8,0,0" />
          <Border Classes="dialog-detail">
            <TextBlock Text="https://github.com/bruce48x/Lakona/issues" Classes="gold control-label" TextWrapping="Wrap" />
          </Border>
          <WrapPanel Classes="dialog-actions">
            <Button Classes="secondary" Height="48" MinWidth="108" Margin="0,0,12,0" Padding="18,8" Content="{Binding Localization.Text.Cancel}" Click="CancelHelp_Click" />
            <Button Classes="primary" Height="48" MinWidth="184" Padding="18,8" Content="{Binding Localization.Text.OpenGitHubIssues}" Click="OpenHelpIssues_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="CrashReportOverlay" Grid.ColumnSpan="2" IsVisible="False" Background="{DynamicResource HubBrush.Overlay}">
      <Border Classes="dialog-surface" MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="0">
          <Border Classes="dialog-icon" Width="52" Height="52" HorizontalAlignment="Left">
            <icons:FluentIcon Icon="Warning" IconVariant="Regular" IconSize="Size28" Foreground="{DynamicResource HubBrush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding Localization.Text.PreviousCrashTitle}" Classes="dialog-title" Margin="0,16,0,0" />
          <TextBlock Text="{Binding Localization.Text.PreviousCrashDescription}" Classes="muted dialog-body" TextWrapping="Wrap" Margin="0,8,0,0" />
          <Border Classes="dialog-detail">
            <TextBlock x:Name="CrashReportSummaryText" Classes="muted caption" TextWrapping="Wrap" />
          </Border>
          <TextBlock Text="{Binding Localization.Text.CrashPrivacyNotice}" Classes="muted caption" TextWrapping="Wrap" Margin="0,12,0,0" />
          <WrapPanel Classes="dialog-actions">
            <Button Classes="secondary" Height="48" MinWidth="108" Margin="0,0,12,0" Padding="18,8" Content="{Binding Localization.Text.IgnoreCrashReport}" Click="DismissCrashReport_Click" />
            <Button Classes="primary" Height="48" MinWidth="184" Padding="18,8" Content="{Binding Localization.Text.SendCrashFeedback}" Click="SendCrashReport_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border x:Name="SdkInstallOverlay" Grid.ColumnSpan="2" IsVisible="False" Background="{DynamicResource HubBrush.Overlay}">
      <Border Classes="dialog-surface" MaxWidth="540" HorizontalAlignment="Center" VerticalAlignment="Center">
        <StackPanel Spacing="0">
          <Border Classes="dialog-icon" Width="52" Height="52" HorizontalAlignment="Left">
            <icons:FluentIcon Icon="ArrowDownload" IconVariant="Regular" IconSize="Size28" Foreground="{DynamicResource HubBrush.Accent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding Localization.Text.DotNetSdkRequiredTitle}" Classes="dialog-title" Margin="0,16,0,0" />
          <TextBlock Text="{Binding Localization.Text.DotNetSdkRequiredDescription}" Classes="muted dialog-body" TextWrapping="Wrap" Margin="0,8,0,0" />
          <Border Classes="dialog-detail">
            <StackPanel Spacing="5">
              <TextBlock Text="{Binding Localization.Text.DotNetSdkDownloadSource}" Classes="gold caption" />
              <TextBlock Text="{Binding Localization.Text.DotNetSdkInstallLocation}" Classes="muted caption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <StackPanel x:Name="SdkInstallProgressPanel" IsVisible="False" Margin="0,20,0,0" Spacing="6">
            <ProgressBar x:Name="SdkInstallProgress" Minimum="0" Maximum="100" Height="8" />
            <TextBlock x:Name="SdkInstallProgressText" Classes="muted caption" TextWrapping="Wrap" />
          </StackPanel>
          <TextBlock x:Name="SdkInstallErrorText" IsVisible="False" Foreground="{DynamicResource HubBrush.TextError}" Classes="caption" TextWrapping="Wrap" Margin="0,14,0,0" />
          <WrapPanel Classes="dialog-actions">
            <Button x:Name="CancelSdkInstallButton" Classes="secondary" Height="48" MinWidth="108" Margin="0,0,12,0" Padding="18,8" Content="{Binding Localization.Text.Cancel}" Click="CancelSdkInstall_Click" />
            <Button x:Name="ConfirmSdkInstallButton" Classes="primary" Height="48" MinWidth="184" Padding="18,8" Content="{Binding Localization.Text.DownloadAndInstallSdk}" Click="InstallSdk_Click" />
          </WrapPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.ColumnSpan="2" Width="6" HorizontalAlignment="Left" Background="Transparent" Cursor="SizeWestEast" Tag="West" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Width="6" HorizontalAlignment="Right" Background="Transparent" Cursor="SizeWestEast" Tag="East" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Height="6" VerticalAlignment="Top" Background="Transparent" Cursor="SizeNorthSouth" Tag="North" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Height="6" VerticalAlignment="Bottom" Background="Transparent" Cursor="SizeNorthSouth" Tag="South" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Top" Background="Transparent" Cursor="TopLeftCorner" Tag="NorthWest" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Top" Background="Transparent" Cursor="TopRightCorner" Tag="NorthEast" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomLeftCorner" Tag="SouthWest" PointerPressed="ResizeGrip_PointerPressed" />
    <Border Grid.ColumnSpan="2" Width="10" Height="10" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="Transparent" Cursor="BottomRightCorner" Tag="SouthEast" PointerPressed="ResizeGrip_PointerPressed" />
  </Grid>
  </Border>
</Window>
