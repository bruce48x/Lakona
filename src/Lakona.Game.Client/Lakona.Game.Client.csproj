<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Lakona.Game.Client</RootNamespace>
    <PackageId>Lakona.Game.Client</PackageId>
    <Version>0.4.14</Version>
    <Description>Engine-neutral client helpers for Lakona.Game applications, including reliable push sequence tracking.</Description>
    <PackageTags>game-client;unity;godot</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lakona.Game.Abstractions\Lakona.Game.Abstractions.csproj" />
    <ProjectReference Include="..\Lakona.Rpc.Client\Lakona.Rpc.Client.csproj" />
    <ProjectReference Include="..\Lakona.Rpc.Core\Lakona.Rpc.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
