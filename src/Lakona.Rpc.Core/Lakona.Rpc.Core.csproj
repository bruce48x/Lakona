<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>netstandard2.1;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PackageId>Lakona.Rpc.Core</PackageId>
    <Version>0.13.13</Version>
    <Description>Lakona.Rpc core abstractions, contracts, envelopes, and framing helpers.</Description>
    <PackageTags>rpc;unity;dotnet;transport</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="buildTransitive\Lakona.Rpc.Core.props" Pack="true" PackagePath="buildTransitive" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lakona.Rpc.Analyzers\Lakona.Rpc.Analyzers.csproj"
                      ReferenceOutputAssembly="false"
                      OutputItemType="Analyzer"
                      PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <PackageInputProject Include="..\Lakona.Rpc.Analyzers\Lakona.Rpc.Analyzers.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <TargetsForTfmSpecificContentInPackage>
      $(TargetsForTfmSpecificContentInPackage);IncludeRpcAnalyzerInPackage
    </TargetsForTfmSpecificContentInPackage>
  </PropertyGroup>

  <Target Name="IncludeRpcAnalyzerInPackage"
          Condition="'$(TargetFramework)' == 'netstandard2.1'">
    <MSBuild Projects="..\Lakona.Rpc.Analyzers\Lakona.Rpc.Analyzers.csproj"
             Targets="GetTargetPath"
             Properties="Configuration=$(Configuration);TargetFramework=netstandard2.0">
      <Output TaskParameter="TargetOutputs" ItemName="_RpcAnalyzerOutput" />
    </MSBuild>
    <ItemGroup>
      <TfmSpecificPackageFile Include="@(_RpcAnalyzerOutput)"
                              PackagePath="analyzers/dotnet/cs" />
    </ItemGroup>
  </Target>

</Project>
