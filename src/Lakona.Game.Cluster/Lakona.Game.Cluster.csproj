<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Lakona.Game.Cluster</RootNamespace>
    <PackageId>Lakona.Game.Cluster</PackageId>
    <Version>0.5.6</Version>
    <Description>Optional explicit cluster routing contracts and in-memory runtime primitives for Lakona.Game.</Description>
    <PackageTags>lakona-game;game;cluster;routing;actor</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Lakona.Game.Cluster.Rpc.Tests" />
    <InternalsVisibleTo Include="Lakona.Game.Cluster.Tests" />
    <InternalsVisibleTo Include="Lakona.Game.Server" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="" />
  </ItemGroup>
</Project>
