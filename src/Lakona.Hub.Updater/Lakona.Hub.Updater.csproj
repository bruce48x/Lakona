<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsPackable>false</IsPackable>
    <PublishAot Condition="'$(Configuration)' == 'Release'">true</PublishAot>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>../Lakona.Hub/Assets/lakona-hub.ico</ApplicationIcon>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Lakona.Hub.Installation/Lakona.Hub.Installation.csproj" />
    <InternalsVisibleTo Include="Lakona.Hub.Tests" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.5" />
    <AvaloniaResource Include="../Lakona.Hub/Assets/lakona-hub-256.png" Link="Assets/lakona-hub-256.png" />
    <AvaloniaResource Include="../Lakona.Hub/HubPalette.axaml" Link="HubPalette.axaml" />
  </ItemGroup>
</Project>
